<Application x:Class="GamingCenter.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is swapped by ThemeService (dark/light) -->
                <ResourceDictionary Source="pack://application:,,,/Resources/Theme/Colors.Dark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Resources/Theme/Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Views/ViewTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
