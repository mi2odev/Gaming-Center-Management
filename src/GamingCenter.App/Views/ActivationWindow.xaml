<Window x:Class="GamingCenter.App.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:parts="clr-namespace:GamingCenter.App.Views.Parts"
        Title="mi2o Gaming Center" Width="760" Height="720" MinWidth="560" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg.App}"
        FontFamily="{DynamicResource Font.UI}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="/Resources/Images/app.ico">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.6" RadiusY="0.5">
                <GradientStop Offset="0" Color="{DynamicResource C.PlaceholderEnd}"/>
                <GradientStop Offset="0.7" Color="{DynamicResource C.App}"/>
            </RadialGradientBrush>
        </Grid.Background>
        <StackPanel Width="480" VerticalAlignment="Center" HorizontalAlignment="Center">
            <parts:Logo Width="240" Margin="0,0,0,24"/>
            <Border Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="28">
                <StackPanel>
                    <TextBlock Text="Activate mi2o Gaming Center" Style="{StaticResource T.Base}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Send the PC code below to the seller. You will receive a license key that works on this PC only."
                               Style="{StaticResource T.Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>

                    <TextBlock Text="PC code" Style="{StaticResource T.Label}"/>
                    <DockPanel>
                        <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copy" Style="{StaticResource Btn.Secondary}" Height="44" Padding="16,0" Margin="8,0,0,0" Click="OnCopy"/>
                        <TextBox x:Name="MachineCodeBox" IsReadOnly="True" Height="44" FontSize="16" Padding="14,0"
                                 FontFamily="{DynamicResource Font.Mono}" VerticalContentAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="License key" Style="{StaticResource T.Label}" Margin="0,18,0,6"/>
                    <TextBox x:Name="KeyBox" Height="96" FontSize="12" Padding="10" TextWrapping="Wrap" AcceptsReturn="False"
                             FontFamily="{DynamicResource Font.Mono}" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>

                    <TextBlock x:Name="ErrorText" Style="{StaticResource T.Error}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <Button Content="Activate" Style="{StaticResource Btn.Primary}" Height="48" FontSize="14" Margin="0,16,0,0" IsDefault="True" Click="OnActivate"/>
                    <Button Content="Quit" Style="{StaticResource Btn.Link}" HorizontalAlignment="Center" Margin="0,12,0,0" IsCancel="True" Click="OnQuit"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
