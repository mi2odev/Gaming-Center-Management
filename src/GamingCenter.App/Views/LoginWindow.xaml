<Window x:Class="GamingCenter.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:GamingCenter.App.Controls"
        xmlns:parts="clr-namespace:GamingCenter.App.Views.Parts"
        Title="{Binding CenterName}" Width="1100" Height="760" MinWidth="640" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg.App}"
        FontFamily="{DynamicResource Font.UI}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="/Resources/Images/app.ico">
    <!-- Design 1m -->
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.6" RadiusY="0.5">
                <GradientStop Offset="0" Color="{DynamicResource C.PlaceholderEnd}"/>
                <GradientStop Offset="0.7" Color="{DynamicResource C.App}"/>
            </RadialGradientBrush>
        </Grid.Background>
        <StackPanel Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
            <parts:Logo LogoPath="{Binding LogoPath}" Width="300" Margin="0,0,0,28"/>
            <Border Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="28">
                <StackPanel>
                    <TextBlock Style="{StaticResource T.Base}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Run Text="Sign in to"/> <Run Text="{Binding CenterName, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="Username" Style="{StaticResource T.Label}"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="44" FontSize="14" Padding="14,0" c:Ui.FocusOnLoad="True"/>
                    <TextBlock Text="Password" Style="{StaticResource T.Label}" Margin="0,14,0,6"/>
                    <PasswordBox c:Ui.BoundPassword="{Binding Password, Mode=TwoWay}"/>
                    <TextBlock Text="{Binding Error}" Style="{StaticResource T.Error}" Margin="0,12,0,0"/>
                    <Button Content="Sign in" Style="{StaticResource Btn.Primary}" Height="48" FontSize="14" Margin="0,20,0,0" IsDefault="True"
                            Command="{Binding SignInCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Equals}, ConverterParameter=False}"/>
                    <DockPanel Margin="0,16,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Footer}" Style="{StaticResource T.Faint}"/>
                        <TextBlock Text="Local database · offline" Style="{StaticResource T.Faint}"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
