<Window x:Class="GamingCenter.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GamingCenter.App.ViewModels"
        xmlns:c="clr-namespace:GamingCenter.App.Controls"
        xmlns:svc="clr-namespace:GamingCenter.App.Services"
        xmlns:parts="clr-namespace:GamingCenter.App.Views.Parts"
        Title="{Binding CenterName}" Width="1600" Height="900" MinWidth="1280" MinHeight="720"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg.App}" FontFamily="{DynamicResource Font.UI}"
        Foreground="{DynamicResource Text}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" Icon="/Resources/Images/app.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border x:Name="Sidebar" Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="240"/>
                    <Setter Property="Padding" Value="16,20"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact}" Value="True">
                            <Setter Property="Width" Value="68"/>
                            <Setter Property="Padding" Value="8,16"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel LastChildFill="False">
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,8,22">
                    <parts:Logo LogoPath="{Binding LogoPath}" Height="44"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsCompact, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock Text="mi2o" Style="{StaticResource T.Base}" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="Gaming Center" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel.Resources>
                        <Style TargetType="RadioButton" BasedOn="{StaticResource NavItem}">
                            <Setter Property="GroupName" Value="Nav"/>
                            <Setter Property="Command" Value="{Binding NavigateCommand}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                    <Setter Property="Tag" Value="Compact"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Resources>
                    <RadioButton Content="Dashboard" c:Ui.Icon="{StaticResource I.Dashboard}" CommandParameter="{x:Static vm:Page.Dashboard}"
                                 IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Dashboard}"/>
                    <RadioButton Content="Gaming Stations" c:Ui.Icon="{StaticResource I.Gamepad}" CommandParameter="{x:Static vm:Page.Stations}"
                                 IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Stations}"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                    <RadioButton Content="Sessions" c:Ui.Icon="{StaticResource I.History}" CommandParameter="{x:Static vm:Page.Sessions}"
                                 IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Sessions}"/>
                    <RadioButton Content="Products" c:Ui.Icon="{StaticResource I.Box}" CommandParameter="{x:Static vm:Page.Products}"
                                 IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Products}"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                    <RadioButton Content="Customers" c:Ui.Icon="{StaticResource I.Users}" CommandParameter="{x:Static vm:Page.Customers}"
                                 IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Customers}"/>
                    <RadioButton Content="Sales" c:Ui.Icon="{StaticResource I.Receipt}" CommandParameter="{x:Static vm:Page.Sales}"
                                 IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Sales}"/>
                    <RadioButton Content="Reports" c:Ui.Icon="{StaticResource I.Chart}" CommandParameter="{x:Static vm:Page.Reports}"
                                 IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Reports}"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                    <RadioButton Content="Users" c:Ui.Icon="{StaticResource I.Shield}" CommandParameter="{x:Static vm:Page.Users}"
                                 IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Users}"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                    <RadioButton Content="Settings" c:Ui.Icon="{StaticResource I.Settings}" CommandParameter="{x:Static vm:Page.Settings}"
                                 IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Settings}"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <!-- User block -->
                <Grid DockPanel.Dock="Bottom">
                    <Button x:Name="UserButton" Command="{Binding ToggleUserMenuCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="8,10">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Border}">
                                <TextBlock Text="{Binding UserInitials}" Style="{StaticResource T.Base}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsCompact, Converter={StaticResource InvBoolToVis}}">
                                <TextBlock Text="{Binding UserName}" Style="{StaticResource T.Base}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding UserRole}" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource T.Faint}">
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Popup IsOpen="{Binding IsUserMenuOpen}" PlacementTarget="{Binding ElementName=UserButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True"
                           Closed="OnUserMenuClosed">
                        <Border Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,6" MinWidth="200">
                            <StackPanel>
                                <Button Content="Change password" Style="{StaticResource Btn.Link}" FontSize="13" Padding="12,9" HorizontalContentAlignment="Left" Command="{Binding ChangePasswordCommand}"/>
                                <Button Content="Sign out" Style="{StaticResource Btn.Link}" FontSize="13" Padding="12,9" HorizontalContentAlignment="Left" c:Ui.Icon="{StaticResource I.Logout}" Command="{Binding SignOutCommand}"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ===== Main ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="32,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding CurrentPage.Title}" Style="{StaticResource T.PageTitle}" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Search -->
                        <Grid Width="360" Margin="0,0,16,0" x:Name="SearchHost">
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Search stations, products, customers, receipts…"
                                     Padding="34,0,60,0" PreviewKeyDown="OnSearchKeyDown"/>
                            <c:Icon Data="{StaticResource I.Search}" Width="15" Height="15" Foreground="{DynamicResource Text.Faint}" HorizontalAlignment="Left" Margin="12,0,0,0"/>
                            <Border HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="6,1" IsHitTestVisible="False">
                                <TextBlock Text="Ctrl K" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{DynamicResource Text.Faint}"/>
                            </Border>
                            <Popup IsOpen="{Binding IsSearchOpen}" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="{Binding ActualWidth, ElementName=SearchHost}">
                                <Border Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,6,0,0" MaxHeight="440">
                                    <Grid>
                                        <TextBlock Text="No results" Style="{StaticResource T.Muted}" Margin="12,10" Visibility="{Binding SearchResults.Count, Converter={StaticResource NoValueToVis}}"/>
                                        <ListBox x:Name="SearchList" ItemsSource="{Binding SearchResults}" Background="Transparent" BorderThickness="0" MouseLeftButtonUp="OnSearchResultClick" KeyDown="OnSearchListKeyDown"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bd" Padding="12,8" CornerRadius="6" Background="Transparent" Cursor="Hand">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Selected}"/></Trigger>
                                                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Selected}"/></Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right" Background="{DynamicResource Bg.Selected}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Kind}" Style="{StaticResource T.Faint}"/>
                                                        </Border>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource T.Base}" FontWeight="Medium"/>
                                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>

                        <TextBlock Text="{Binding ClockText}" Style="{StaticResource T.Mono}" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <!-- Notifications -->
                        <Grid Margin="0,0,16,0">
                            <Button x:Name="BellButton" Style="{StaticResource Btn.Icon}" c:Ui.Icon="{StaticResource I.Bell}" Command="{Binding ToggleNotificationsCommand}" ToolTip="Notifications"/>
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Danger}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,8,0" IsHitTestVisible="False"
                                     Visibility="{Binding Notifications.Unread, Converter={StaticResource HasValueToVis}}"/>
                            <Popup IsOpen="{Binding IsNotificationsOpen}" PlacementTarget="{Binding ElementName=BellButton}" Placement="Bottom" HorizontalOffset="-320" StaysOpen="False" AllowsTransparency="True"
                                   Closed="OnNotificationsClosed">
                                <Border Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1" CornerRadius="10" Margin="0,6,0,0" Width="360" MaxHeight="480">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="16,14,16,8">
                                            <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource Btn.Link}" Command="{Binding ClearNotificationsCommand}"/>
                                            <TextBlock Text="Notifications" Style="{StaticResource T.Base}" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <Grid>
                                            <TextBlock Text="Nothing new. Alerts about ending sessions, long sessions and low stock appear here." Style="{StaticResource T.Muted}" TextWrapping="Wrap" Margin="16,4,16,16"
                                                       Visibility="{Binding Notifications.Items.Count, Converter={StaticResource NoValueToVis}}"/>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Notifications.Items}" Margin="8,0,8,8">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="8,8" BorderBrush="{DynamicResource Row.Divider}" BorderThickness="0,0,0,1">
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TimeLabel}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{DynamicResource Text.Faint}"/>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource T.Base}" FontSize="12" FontWeight="SemiBold"
                                                                                   Foreground="{Binding Kind, Converter={StaticResource StatusBrush}, ConverterParameter=Toast.}"/>
                                                                        <TextBlock Text="{Binding Message}" Style="{StaticResource T.Muted}" TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                </DockPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <Button Content="Start session" Style="{StaticResource Btn.Primary}" c:Ui.Icon="{StaticResource I.Plus}" Command="{Binding StartSessionCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Page -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False"/>
        </Grid>

        <!-- ===== Dialog layer ===== -->
        <ItemsControl Grid.ColumnSpan="2" ItemsSource="{Binding Dialogs.Open}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><Grid/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Border Background="{DynamicResource Overlay}" MouseLeftButtonDown="OnBackdropClick"/>
                        <ContentPresenter Content="{Binding}" KeyboardNavigation.TabNavigation="Cycle">
                            <ContentPresenter.Style>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="24"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Placement}" Value="{x:Static svc:DialogPlacement.Right}">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                                            <Setter Property="Margin" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Style>
                        </ContentPresenter>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== Toasts ===== -->
        <ItemsControl Grid.ColumnSpan="2" ItemsSource="{Binding Toasts.Items}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Width="380" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <parts:ToastView Margin="0,8,0,0"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
