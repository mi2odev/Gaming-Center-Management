<UserControl x:Class="GamingCenter.App.Views.Dialogs.BillDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="clr-namespace:GamingCenter.App.Views.Dialogs">
    <!-- Design 1g -->
    <Border Style="{StaticResource DialogCard}" Width="940" MinHeight="560">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>
            <!-- Bill -->
            <DockPanel Margin="32,28">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding Header}" Style="{StaticResource T.Muted}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StationName}" Style="{StaticResource T.Base}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding SessionLine}" Style="{StaticResource T.Muted}" Margin="0,2,0,0"/>

                    <TextBlock Text="Gaming" Style="{StaticResource T.Muted}" FontWeight="SemiBold" Margin="0,22,0,8"/>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding GamingText}" Style="{StaticResource T.MonoStrong}"/>
                        <TextBlock Style="{StaticResource T.Base}"><Run Text="{Binding GamingDetail, Mode=OneWay}"/> <Run Text="{Binding GamingRate, Mode=OneWay}" Foreground="{DynamicResource Text.Muted}"/></TextBlock>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding RateLines}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource T.Mono}" FontSize="12" Foreground="{DynamicResource Text.Muted}" Margin="0,0,0,3"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding PauseNote}" Style="{StaticResource T.Faint}" Margin="0,4,0,0" Visibility="{Binding PauseNote, Converter={StaticResource HasValueToVis}}"/>

                    <StackPanel Visibility="{Binding HasLines, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Consumption" Style="{StaticResource T.Muted}" FontWeight="SemiBold" Margin="0,20,0,8"/>
                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Total}" Style="{StaticResource T.Mono}"/>
                                        <TextBlock Style="{StaticResource T.Base}"><Run Text="{Binding Name, Mode=OneWay}"/> <Run Text="×" Foreground="{DynamicResource Text.Muted}"/><Run Text="{Binding Quantity, Mode=OneWay}" Foreground="{DynamicResource Text.Muted}"/></TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Rectangle Height="1" Stroke="{DynamicResource Border}" StrokeDashArray="4 3" Margin="0,2,0,6"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ProductsText}" Style="{StaticResource T.MonoStrong}"/>
                            <TextBlock Text="Consumption total" Style="{StaticResource T.Muted}" FontSize="13"/>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="{DynamicResource Bg.Card}" CornerRadius="10" Padding="18,16" Margin="0,20,0,0">
                    <StackPanel>
                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding GamingText}" Style="{StaticResource T.Mono}" Foreground="{DynamicResource Text.Muted}"/><TextBlock Text="Gaming" Style="{StaticResource T.Muted}" FontSize="13"/></DockPanel>
                        <DockPanel Margin="0,6,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding ProductsText}" Style="{StaticResource T.Mono}" Foreground="{DynamicResource Text.Muted}"/><TextBlock Text="Products" Style="{StaticResource T.Muted}" FontSize="13"/></DockPanel>
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" Style="{StaticResource T.MonoStrong}" FontSize="30"/>
                                <TextBlock Text="Total" Style="{StaticResource T.H15}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Border/>
            </DockPanel>

            <!-- Payment -->
            <Border Grid.Column="1" Background="{DynamicResource Bg.App}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0" CornerRadius="0,16,16,0" Padding="32,28">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Text="{Binding FooterNote}" Style="{StaticResource T.Faint}" TextWrapping="Wrap" TextTrimming="None" LineHeight="16" Margin="0,0,0,12"/>
                        <Button Content="Back to session" Style="{StaticResource Btn.Secondary}" Height="42" Foreground="{DynamicResource Text.Muted}" Command="{Binding BackCommand}" IsCancel="True"/>
                    </StackPanel>
                    <d:PaymentPanel/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
