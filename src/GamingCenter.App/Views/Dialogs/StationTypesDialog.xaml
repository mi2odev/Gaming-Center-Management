<UserControl x:Class="GamingCenter.App.Views.Dialogs.StationTypesDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls"
             xmlns:cm="clr-namespace:GamingCenter.Application.Common;assembly=GamingCenter.Application"
             xmlns:parts="clr-namespace:GamingCenter.App.Views.Parts">
    <Border Style="{StaticResource DialogCard}" Width="640" MaxHeight="720">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource DialogHeader}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="34" Height="34" MinHeight="0" c:Ui.Icon="{StaticResource I.X}" Command="{Binding CancelCommand}"/>
                    <StackPanel>
                        <TextBlock Text="Station types" Style="{StaticResource T.Base}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="PlayStation, PC, Xbox, simulators… Add new types without changing any code." Style="{StaticResource T.Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="90"/><ColumnDefinition Width="10"/><ColumnDefinition Width="120"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Name" Style="{StaticResource T.Label}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="e.g. Racing simulator"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Tag" Style="{StaticResource T.Label}"/><TextBox Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="SIM"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="Default price / h" Style="{StaticResource T.Label}"/><TextBox Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Mono}"/></StackPanel>
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="New" Style="{StaticResource Btn.Link}" Margin="0,0,12,0" Command="{Binding NewCommand}"
                                    Visibility="{Binding EditId, Converter={StaticResource HasValueToVis}}"/>
                            <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,0,12,0"/>
                            <Button Style="{StaticResource Btn.Primary}" Command="{Binding SaveCommand}" Content="{Binding SaveText}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Extra controller price / h" Style="{StaticResource T.Label}"/>
                            <TextBox Text="{Binding ExtraRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Mono}" c:Ui.Suffix="{x:Static cm:Money.CurrencySymbol}" c:Ui.Placeholder="100"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <TextBlock Text="Same price for every console of this type. Empty uses the default from Settings." Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap" TextTrimming="None"/>
                            <CheckBox Content="Also remove the stations' own prices" IsChecked="{Binding ApplyToAll}" Margin="0,6,0,0"
                                      Visibility="{Binding EditId, Converter={StaticResource HasValueToVis}}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Error}" Style="{StaticResource T.Error}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,10">
                <ItemsControl ItemsSource="{Binding Types}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Row.Divider}" BorderThickness="0,0,0,1" Padding="0,10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Edit" Style="{StaticResource Btn.Link}" Margin="0,0,14,0" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <Button Content="Delete" Style="{StaticResource Btn.Link}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                    <Border Width="46" Height="30" CornerRadius="5" Background="{DynamicResource Bg.Placeholder}" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Tag}" Style="{StaticResource T.Base}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Text.Faint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}" FontWeight="Medium"/>
                                        <TextBlock Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}">
                                            <Run Text="{Binding StationCount, Mode=OneWay}"/><Run Text=" stations · default "/><Run Text="{Binding DefaultHourlyRate, Mode=OneWay, Converter={StaticResource Money}}"/><Run Text="/h"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource T.Faint}" Foreground="{DynamicResource Accent}" Visibility="{Binding ExtraControllerRate, Converter={StaticResource HasValueToVis}}">
                                            <Run Text="+"/><Run Text="{Binding ExtraControllerRate, Mode=OneWay, Converter={StaticResource Money}}"/><Run Text="/h"/><Run Text=" per extra controller"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
