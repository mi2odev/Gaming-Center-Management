<UserControl x:Class="GamingCenter.App.Views.Dialogs.ProductEditorDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls"
             xmlns:cm="clr-namespace:GamingCenter.Application.Common;assembly=GamingCenter.Application"
             xmlns:parts="clr-namespace:GamingCenter.App.Views.Parts">
    <Border Style="{StaticResource DialogCard}" Width="620">
        <StackPanel>
            <Border Style="{StaticResource DialogHeader}">
                <TextBlock Text="{Binding Title}" Style="{StaticResource T.Base}" FontSize="17" FontWeight="SemiBold"/>
            </Border>
            <Grid Margin="26,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Height="150" CornerRadius="10" BorderBrush="{DynamicResource Border.Dashed}" BorderThickness="1" ClipToBounds="True"
                            c:Ui.ClickCommand="{Binding ChooseImageCommand}" c:Ui.ImageDropCommand="{Binding ImportImageCommand}" ToolTip="Click or drop a picture here">
                        <Grid>
                            <parts:Thumb ImagePath="{Binding ImagePath}" TagText="IMAGE" TagSize="14" CornerRadius="10"/>
                        </Grid>
                    </Border>
                    <Button Content="Upload picture…" Style="{StaticResource Btn.Secondary}" c:Ui.Icon="{StaticResource I.Image}" MinHeight="32" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding ChooseImageCommand}"/>
                    <Button Content="Remove image" Style="{StaticResource Btn.Link}" Margin="0,6,0,0" HorizontalAlignment="Left" Command="{Binding RemoveImageCommand}"
                            Visibility="{Binding ImagePath, Converter={StaticResource HasValueToVis}}"/>
                    <TextBlock Text="Or drag a picture onto the box. Resized to 800 px and stored locally." Style="{StaticResource T.Faint}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.ColumnSpan="3"><TextBlock Text="Name" Style="{StaticResource T.Label}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Coca-Cola 33cl" c:Ui.FocusOnLoad="True"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0"><TextBlock Text="Category" Style="{StaticResource T.Label}"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Name"/></StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="Purchase price" Style="{StaticResource T.Label}"/><TextBox Text="{Binding Purchase, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Mono}" c:Ui.Suffix="{x:Static cm:Money.CurrencySymbol}"/></StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0"><TextBlock Text="Selling price" Style="{StaticResource T.Label}"/><TextBox Text="{Binding Selling, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Mono}" c:Ui.Suffix="{x:Static cm:Money.CurrencySymbol}"/></StackPanel>
                    <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="Stock" Style="{StaticResource T.Label}"/><TextBox Text="{Binding Stock, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Mono}"/></StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,12,0,0"><TextBlock Text="Minimum stock" Style="{StaticResource T.Label}"/><TextBox Text="{Binding MinStock, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Mono}"/></StackPanel>
                    <DockPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,14,0,0">
                        <CheckBox DockPanel.Dock="Right" Content="Active (sold in catalog)" IsChecked="{Binding IsActive}"/>
                        <TextBlock Text="{Binding ProfitText}" Style="{StaticResource T.Muted}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Grid>
            </Grid>
            <TextBlock Text="{Binding Error}" Style="{StaticResource T.Error}" Margin="26,0,26,10"/>
            <Border Style="{StaticResource DialogFooter}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource Btn.Secondary}" Command="{Binding CancelCommand}" Margin="0,0,10,0" IsCancel="True"/>
                    <Button Content="Save product" Style="{StaticResource Btn.Primary}" Command="{Binding SaveCommand}" IsDefault="True"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
