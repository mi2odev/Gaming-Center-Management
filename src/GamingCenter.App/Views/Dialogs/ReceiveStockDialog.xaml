<UserControl x:Class="GamingCenter.App.Views.Dialogs.ReceiveStockDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls"
             xmlns:parts="clr-namespace:GamingCenter.App.Views.Parts">
    <Border Style="{StaticResource DialogCard}" Width="480">
        <StackPanel Margin="26,24">
            <TextBlock Text="Receive stock" Style="{StaticResource T.Base}" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="Product" Style="{StaticResource T.Label}" Margin="0,18,0,6"/>
            <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding Product}" DisplayMemberPath="Name"/>
            <TextBlock Text="{Binding CurrentStock}" Style="{StaticResource T.Muted}" Margin="0,8,0,0"/>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
                                <Setter Property="Text" Value="Quantity received"/>
                                <Style.Triggers><DataTrigger Binding="{Binding SetExact}" Value="True"><Setter Property="Text" Value="Counted stock"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Mono}" c:Ui.FocusOnLoad="True"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Note" Style="{StaticResource T.Label}"/>
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Supplier, invoice… (optional)"/>
                </StackPanel>
            </Grid>
            <CheckBox Content="Set the exact counted stock instead of adding" IsChecked="{Binding SetExact}" Margin="0,14,0,0"/>
            <TextBlock Text="{Binding Error}" Style="{StaticResource T.Error}" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" Style="{StaticResource Btn.Secondary}" Command="{Binding CancelCommand}" Margin="0,0,10,0" IsCancel="True"/>
                <Button Content="Save" Style="{StaticResource Btn.Primary}" Command="{Binding SaveCommand}" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
