<UserControl x:Class="GamingCenter.App.Views.Dialogs.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls"
             xmlns:parts="clr-namespace:GamingCenter.App.Views.Parts">
    <Border Style="{StaticResource DialogCard}" Width="460">
        <StackPanel>
            <StackPanel Margin="26,24,26,8">
                <TextBlock Text="{Binding Title}" Style="{StaticResource T.Base}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Message}" Style="{StaticResource T.Muted}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" Margin="0,10,0,0" LineHeight="20"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="26,18,26,22">
                <Button Content="Cancel" Style="{StaticResource Btn.Secondary}" Command="{Binding CancelCommand}" Margin="0,0,10,0" IsCancel="True"/>
                <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" c:Ui.FocusOnLoad="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Danger}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Danger.Fg}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
