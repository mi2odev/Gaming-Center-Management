<UserControl x:Class="GamingCenter.App.Views.Dialogs.RepaymentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls"
             xmlns:cm="clr-namespace:GamingCenter.Application.Common;assembly=GamingCenter.Application">
    <Border Style="{StaticResource DialogCard}" Width="480">
        <StackPanel Margin="26,24">
            <TextBlock Text="{Binding Title}" Style="{StaticResource T.Base}" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding OwesText}" Style="{StaticResource T.Base}" FontSize="13" Foreground="{DynamicResource Warning}" Margin="0,4,0,0"/>
            <DockPanel Margin="0,18,0,6">
                <Button DockPanel.Dock="Right" Content="Everything" Style="{StaticResource Btn.LinkAccent}" Command="{Binding AllCommand}"/>
                <TextBlock Text="Amount paid back" Style="{StaticResource T.Label}" Margin="0"/>
            </DockPanel>
            <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Big}" c:Ui.Suffix="{x:Static cm:Money.CurrencySymbol}"
                     c:Ui.SelectAllOnFocus="True" c:Ui.FocusOnLoad="True"/>
            <TextBlock Text="{Binding AfterText}" Style="{StaticResource T.Muted}" Margin="0,8,0,0"/>
            <UniformGrid Columns="3" Margin="-4,16,-4,0">
                <RadioButton Style="{StaticResource OptionCard}" Margin="4,0" GroupName="RepayMethod" HorizontalContentAlignment="Center" IsChecked="{Binding Method, Converter={StaticResource Equals}, ConverterParameter=Cash}"><TextBlock Text="Cash" FontWeight="SemiBold"/></RadioButton>
                <RadioButton Style="{StaticResource OptionCard}" Margin="4,0" GroupName="RepayMethod" HorizontalContentAlignment="Center" IsChecked="{Binding Method, Converter={StaticResource Equals}, ConverterParameter=Card}"><TextBlock Text="Card" FontWeight="SemiBold"/></RadioButton>
                <RadioButton Style="{StaticResource OptionCard}" Margin="4,0" GroupName="RepayMethod" HorizontalContentAlignment="Center" IsChecked="{Binding Method, Converter={StaticResource Equals}, ConverterParameter=Other}"><TextBlock Text="Other" FontWeight="SemiBold"/></RadioButton>
            </UniformGrid>
            <TextBlock Text="Note" Style="{StaticResource T.Label}" Margin="0,14,0,6"/>
            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Optional"/>
            <TextBlock Text="{Binding Error}" Style="{StaticResource T.Error}" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" Style="{StaticResource Btn.Secondary}" Command="{Binding CancelCommand}" Margin="0,0,10,0" IsCancel="True"/>
                <Button Content="Record payment" Style="{StaticResource Btn.Primary}" Command="{Binding SaveCommand}" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
