<UserControl x:Class="GamingCenter.App.Views.Dialogs.PaymentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls"
             xmlns:parts="clr-namespace:GamingCenter.App.Views.Parts"
             xmlns:cm="clr-namespace:GamingCenter.Application.Common;assembly=GamingCenter.Application">
    <!-- Right column of design 1g. DataContext: PaymentDialogViewModel -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding Error}" Style="{StaticResource T.Error}" Margin="0,0,0,10"/>
            <Button Content="{Binding ConfirmText}" Style="{StaticResource Btn.Primary}" Height="48" FontSize="14" Command="{Binding ConfirmCommand}" IsDefault="True"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
        <StackPanel>
            <TextBlock Text="Payment" Style="{StaticResource T.Section}"/>
            <UniformGrid Columns="3" Margin="-4,16,-4,0">
                <RadioButton Style="{StaticResource OptionCard}" Margin="4,0" GroupName="Method" HorizontalContentAlignment="Center"
                             IsChecked="{Binding Method, Converter={StaticResource Equals}, ConverterParameter=Cash}">
                    <TextBlock Text="Cash" FontWeight="SemiBold" FontSize="13"/>
                </RadioButton>
                <RadioButton Style="{StaticResource OptionCard}" Margin="4,0" GroupName="Method" HorizontalContentAlignment="Center"
                             IsChecked="{Binding Method, Converter={StaticResource Equals}, ConverterParameter=Card}">
                    <TextBlock Text="Card" FontWeight="SemiBold" FontSize="13"/>
                </RadioButton>
                <RadioButton Style="{StaticResource OptionCard}" Margin="4,0" GroupName="Method" HorizontalContentAlignment="Center"
                             IsChecked="{Binding Method, Converter={StaticResource Equals}, ConverterParameter=Other}">
                    <TextBlock Text="Other" FontWeight="SemiBold" FontSize="13"/>
                </RadioButton>
            </UniformGrid>

            <StackPanel Margin="0,18,0,0" Visibility="{Binding ShowAmountField, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding AmountLabel}" Style="{StaticResource T.Label}" FontSize="12" Margin="0,0,0,8"/>
                <TextBox Text="{Binding ReceivedText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Big}"
                         c:Ui.Suffix="{x:Static cm:Money.CurrencySymbol}" c:Ui.SelectAllOnFocus="True" c:Ui.FocusOnLoad="True"/>
                <ItemsControl ItemsSource="{Binding CashPresets}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Content="{Binding Label}" Style="{StaticResource Preset}" Command="{Binding DataContext.SetReceivedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Value}"/>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Split payment: extra lines added with + -->
                <ItemsControl ItemsSource="{Binding ExtraLines}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Mono}" Height="42" FontSize="16"
                                         c:Ui.Suffix="{x:Static cm:Money.CurrencySymbol}" c:Ui.SelectAllOnFocus="True" c:Ui.FocusOnLoad="True"/>
                                <ComboBox Grid.Column="2" Height="42" ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}"/>
                                <Button Grid.Column="4" Style="{StaticResource Btn.Icon}" Width="42" Height="42" c:Ui.Icon="{StaticResource I.X}" ToolTip="Remove this payment"
                                        Command="{Binding DataContext.RemovePaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding PaidSoFarText}" Style="{StaticResource T.Muted}" Margin="0,10,0,0" Visibility="{Binding IsSplit, Converter={StaticResource BoolToVis}}"/>

                <DockPanel Margin="0,12,0,0" Visibility="{Binding PayLater, Converter={StaticResource InvBoolToVis}}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ChangeText}" FontSize="16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource T.MonoStrong}">
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsDiscount}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ChangeLabel}" Style="{StaticResource T.Muted}" FontSize="13" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>

            <Button Content="Add another payment" c:Ui.Icon="{StaticResource I.Plus}" Style="{StaticResource Btn.Secondary}" MinHeight="36" Margin="0,12,0,0"
                    HorizontalAlignment="Stretch" Command="{Binding AddPaymentCommand}" ToolTip="Someone else pays part of the bill"/>

            <Button Content="Owe it instead → put the rest on credit" Style="{StaticResource Btn.LinkAccent}" HorizontalAlignment="Left" Margin="0,10,0,0" ToolTip="The customer will pay the difference another day"
                    Command="{Binding PutMissingOnCreditCommand}" Visibility="{Binding CanOfferCredit, Converter={StaticResource BoolToVis}}"/>

            <CheckBox Content="Pay the rest later (credit)" IsChecked="{Binding PayLater}" Margin="0,18,0,0" FontSize="13" Foreground="{DynamicResource Warning}"/>
            <Border Style="{StaticResource Notice.Warning}" Margin="0,10,0,0" Visibility="{Binding PayLater, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding CreditText}" Style="{StaticResource T.Base}" FontSize="12" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" TextTrimming="None" LineHeight="18"/>
            </Border>

            <CheckBox Content="Print thermal receipt" IsChecked="{Binding PrintReceipt}" Margin="0,14,0,0"/>
            <CheckBox Content="Attach to customer" IsChecked="{Binding AttachCustomer}" Margin="0,12,0,0" IsEnabled="{Binding PayLater, Converter={StaticResource Equals}, ConverterParameter=False}"/>
            <parts:CustomerPicker DataContext="{Binding Customer}" Margin="0,10,0,0"
                                  Visibility="{Binding DataContext.CustomerRequired, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
