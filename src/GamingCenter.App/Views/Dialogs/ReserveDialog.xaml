<UserControl x:Class="GamingCenter.App.Views.Dialogs.ReserveDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls"
             xmlns:parts="clr-namespace:GamingCenter.App.Views.Parts">
    <Border Style="{StaticResource DialogCard}" Width="460">
        <StackPanel Margin="26,24">
            <TextBlock Text="{Binding Title}" Style="{StaticResource T.Base}" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="The card turns amber and the station can still be started when the customer arrives." Style="{StaticResource T.Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Reserved for" Style="{StaticResource T.Label}"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Customer name (optional)" c:Ui.FocusOnLoad="True"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Time" Style="{StaticResource T.Label}"/>
                    <TextBox Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Mono}" c:Ui.Placeholder="20:00"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Error}" Style="{StaticResource T.Error}" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" Style="{StaticResource Btn.Secondary}" Command="{Binding CancelCommand}" Margin="0,0,10,0" IsCancel="True"/>
                <Button Content="Reserve" Style="{StaticResource Btn.Primary}" Command="{Binding ConfirmCommand}" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
