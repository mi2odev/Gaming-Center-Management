<UserControl x:Class="GamingCenter.App.Views.Dialogs.ChangePasswordDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls"
             xmlns:parts="clr-namespace:GamingCenter.App.Views.Parts">
    <Border Style="{StaticResource DialogCard}" Width="440">
        <StackPanel Margin="26,24">
            <TextBlock Text="Change password" Style="{StaticResource T.Base}" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="Current password" Style="{StaticResource T.Label}" Margin="0,18,0,6"/>
            <PasswordBox c:Ui.BoundPassword="{Binding Current, Mode=TwoWay}" Height="38" c:Ui.FocusOnLoad="True"/>
            <TextBlock Text="New password" Style="{StaticResource T.Label}" Margin="0,14,0,6"/>
            <PasswordBox c:Ui.BoundPassword="{Binding NewPassword, Mode=TwoWay}" Height="38"/>
            <TextBlock Text="Repeat new password" Style="{StaticResource T.Label}" Margin="0,14,0,6"/>
            <PasswordBox c:Ui.BoundPassword="{Binding Confirm, Mode=TwoWay}" Height="38"/>
            <TextBlock Text="{Binding Error}" Style="{StaticResource T.Error}" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" Style="{StaticResource Btn.Secondary}" Command="{Binding CancelCommand}" Margin="0,0,10,0" IsCancel="True"/>
                <Button Content="Change password" Style="{StaticResource Btn.Primary}" Command="{Binding SaveCommand}" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
