<UserControl x:Class="GamingCenter.App.Views.Dialogs.ExpenseEditorDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls"
             xmlns:cm="clr-namespace:GamingCenter.Application.Common;assembly=GamingCenter.Application">
    <Border Style="{StaticResource DialogCard}" Width="580">
        <StackPanel>
            <Border Style="{StaticResource DialogHeader}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="11" Background="{DynamicResource Danger.Soft}" Margin="0,0,14,0" VerticalAlignment="Top">
                        <c:Icon Data="{StaticResource I.Banknote}" Width="19" Height="19" Foreground="{DynamicResource Danger}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource T.Base}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Something you paid for the center. Its price is taken off your profit in Reports." Style="{StaticResource T.Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <StackPanel Margin="26,20,26,8">
                <TextBlock Text="What did you buy or pay?" Style="{StaticResource T.Label}"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="e.g. New TV for PS5 #02" c:Ui.FocusOnLoad="True" MaxLength="128"/>

                <TextBlock Text="Category" Style="{StaticResource T.Label}" Margin="0,16,0,8"/>
                <ListBox Style="{StaticResource OptionList}" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="5,0,5,10"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="8,12">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Border.Dashed}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent.Soft}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center">
                                <c:Icon Data="{Binding Value, Converter={StaticResource ExpenseIcon}}" Width="18" Height="18" HorizontalAlignment="Center"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,6,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Price paid" Style="{StaticResource T.Label}"/>
                        <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Mono}" FontSize="16" c:Ui.Suffix="{x:Static cm:Money.CurrencySymbol}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Date" Style="{StaticResource T.Label}"/>
                        <!-- Same height as the price box next to it; future days are not offered -->
                        <DatePicker SelectedDate="{Binding Date}" DisplayDateEnd="{Binding Today, Mode=OneTime}" Height="38" FontSize="14"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Note (optional)" Style="{StaticResource T.Label}" Margin="0,16,0,6"/>
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="e.g. Shop name, warranty until 2028" MaxLength="500"/>
                <TextBlock Text="{Binding Error}" Style="{StaticResource T.Error}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
            <Border Style="{StaticResource DialogFooter}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource Btn.Secondary}" Command="{Binding CancelCommand}" Margin="0,0,10,0" IsCancel="True"/>
                    <Button Content="Save expense" Style="{StaticResource Btn.Primary}" c:Ui.Icon="{StaticResource I.Check}" Command="{Binding SaveCommand}" IsDefault="True"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
