<UserControl x:Class="GamingCenter.App.Views.Dialogs.ExpenseEditorDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls"
             xmlns:cm="clr-namespace:GamingCenter.Application.Common;assembly=GamingCenter.Application">
    <Border Style="{StaticResource DialogCard}" Width="520">
        <StackPanel>
            <Border Style="{StaticResource DialogHeader}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.Base}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Something you paid for the center. Its price is taken off your profit in Reports." Style="{StaticResource T.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <StackPanel Margin="26,20">
                <TextBlock Text="What did you buy or pay?" Style="{StaticResource T.Label}"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="e.g. New TV for PS5 #02" c:Ui.FocusOnLoad="True"/>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Price paid" Style="{StaticResource T.Label}"/>
                        <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Mono}" c:Ui.Suffix="{x:Static cm:Money.CurrencySymbol}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Category" Style="{StaticResource T.Label}"/>
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Name"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Date" Style="{StaticResource T.Label}"/>
                        <DatePicker SelectedDate="{Binding Date}" DisplayDateEnd="{Binding Today, Mode=OneTime}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Note (optional)" Style="{StaticResource T.Label}" Margin="0,14,0,6"/>
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="e.g. Shop name, warranty until 2028"/>
                <TextBlock Text="{Binding Error}" Style="{StaticResource T.Error}" Margin="0,10,0,0"/>
            </StackPanel>
            <Border Style="{StaticResource DialogFooter}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource Btn.Secondary}" Command="{Binding CancelCommand}" Margin="0,0,10,0" IsCancel="True"/>
                    <Button Content="Save expense" Style="{StaticResource Btn.Primary}" Command="{Binding SaveCommand}" IsDefault="True"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
