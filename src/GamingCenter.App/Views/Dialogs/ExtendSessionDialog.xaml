<UserControl x:Class="GamingCenter.App.Views.Dialogs.ExtendSessionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls"
             xmlns:cm="clr-namespace:GamingCenter.Application.Common;assembly=GamingCenter.Application"
             xmlns:parts="clr-namespace:GamingCenter.App.Views.Parts">
    <Border Style="{StaticResource DialogCard}" Width="540">
        <StackPanel>
            <Border Style="{StaticResource DialogHeader}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.Base}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource T.Muted}" Margin="0,4,0,0"><Run Text="{Binding CurrentMode, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding PlayedText, Mode=OneWay}"/></TextBlock>
                </StackPanel>
            </Border>
            <StackPanel Margin="26,20">
                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Tab" Content="Add time" IsEnabled="{Binding CanAddTime}" IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=Time}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Tab" Content="Add money" IsEnabled="{Binding CanAddMoney}" IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=Money}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Tab" Content="Change mode" IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=Mode}"/>
                    </StackPanel>
                </Border>

                <!-- Add time -->
                <StackPanel Visibility="{Binding Tab, Converter={StaticResource EqualsToVis}, ConverterParameter=Time}">
                    <TextBlock Text="Minutes to add" Style="{StaticResource T.Label}"/>
                    <TextBox Text="{Binding MinutesText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Big}" c:Ui.Suffix="min" c:Ui.SelectAllOnFocus="True"/>
                    <ItemsControl ItemsSource="{Binding MinutePresets}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Content="{Binding Label}" Style="{StaticResource Preset}" Command="{Binding DataContext.SetMinutesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Value}"/>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Add money -->
                <StackPanel Visibility="{Binding Tab, Converter={StaticResource EqualsToVis}, ConverterParameter=Money}">
                    <TextBlock Text="Amount to add" Style="{StaticResource T.Label}"/>
                    <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Big}" c:Ui.Suffix="{x:Static cm:Money.CurrencySymbol}" c:Ui.SelectAllOnFocus="True"/>
                    <ItemsControl ItemsSource="{Binding AmountPresets}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Content="{Binding Label}" Style="{StaticResource Preset}" Command="{Binding DataContext.SetAmountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Value}"/>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Change mode -->
                <StackPanel Visibility="{Binding Tab, Converter={StaticResource EqualsToVis}, ConverterParameter=Mode}">
                    <UniformGrid Columns="3" Margin="-5,0">
                        <RadioButton Style="{StaticResource OptionCard}" Margin="5,0" GroupName="NewMode" IsChecked="{Binding NewMode, Converter={StaticResource Equals}, ConverterParameter=Open}">
                            <StackPanel><TextBlock Text="Play freely" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Pay actual time" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" Margin="0,3,0,0"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource OptionCard}" Margin="5,0" GroupName="NewMode" IsChecked="{Binding NewMode, Converter={StaticResource Equals}, ConverterParameter=FixedDuration}">
                            <StackPanel><TextBlock Text="Fixed duration" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Total minutes" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" Margin="0,3,0,0"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource OptionCard}" Margin="5,0" GroupName="NewMode" IsChecked="{Binding NewMode, Converter={StaticResource Equals}, ConverterParameter=FixedBudget}">
                            <StackPanel><TextBlock Text="Fixed budget" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Total amount" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" Margin="0,3,0,0"/></StackPanel>
                        </RadioButton>
                    </UniformGrid>
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding NewMode, Converter={StaticResource EqualsToVis}, ConverterParameter=FixedDuration}">
                        <TextBlock Text="Total duration from session start" Style="{StaticResource T.Label}"/>
                        <TextBox Text="{Binding ModeMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Mono}" c:Ui.Suffix="min"/>
                    </StackPanel>
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding NewMode, Converter={StaticResource EqualsToVis}, ConverterParameter=FixedBudget}">
                        <TextBlock Text="Total budget" Style="{StaticResource T.Label}"/>
                        <TextBox Text="{Binding ModeBudget, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Mono}" c:Ui.Suffix="{x:Static cm:Money.CurrencySymbol}"/>
                    </StackPanel>
                    <TextBlock Text="Time already played stays on the session and is billed under the new mode." Style="{StaticResource T.Faint}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <TextBlock Text="{Binding Error}" Style="{StaticResource T.Error}" Margin="0,12,0,0"/>
            </StackPanel>
            <Border Style="{StaticResource DialogFooter}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource Btn.Secondary}" Command="{Binding CancelCommand}" Margin="0,0,10,0" IsCancel="True"/>
                    <Button Content="Apply" Style="{StaticResource Btn.Primary}" Command="{Binding ApplyCommand}" IsDefault="True"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
