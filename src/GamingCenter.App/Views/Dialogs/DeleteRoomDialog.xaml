<UserControl x:Class="GamingCenter.App.Views.Dialogs.DeleteRoomDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource DialogCard}" Width="440">
        <StackPanel Margin="28,24">
            <TextBlock Text="{Binding Title}" Style="{StaticResource T.Base}" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource T.Muted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,12"/>
            <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" Style="{StaticResource Btn.Secondary}" Margin="0,0,10,0" Command="{Binding CancelCommand}" IsCancel="True"/>
                <Button Content="Delete room" Style="{StaticResource Btn.Danger}" Command="{Binding ConfirmCommand}" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
