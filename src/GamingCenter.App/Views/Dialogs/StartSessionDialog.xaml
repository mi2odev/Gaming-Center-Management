<UserControl x:Class="GamingCenter.App.Views.Dialogs.StartSessionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls"
             xmlns:parts="clr-namespace:GamingCenter.App.Views.Parts"
             xmlns:cm="clr-namespace:GamingCenter.Application.Common;assembly=GamingCenter.Application">
    <!-- Design 1e -->
    <Border Style="{StaticResource DialogCard}" Width="620">
        <StackPanel>
            <!-- Station header -->
            <Border Style="{StaticResource DialogHeader}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource T.MonoStrong}" FontSize="18"><Run Text="{Binding RateNumber, Mode=OneWay}"/><Run Text="/h" FontFamily="{DynamicResource Font.UI}" FontWeight="Normal" FontSize="12" Foreground="{DynamicResource Text.Muted}"/></TextBlock>
                            <TextBlock Text="{Binding BillingLabel}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <Border Width="52" Height="52" CornerRadius="10" ClipToBounds="True" Margin="0,0,14,0">
                            <parts:Thumb ImagePath="{Binding ImagePath}" TagText="{Binding StationTag}" TagSize="13" CornerRadius="10"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding StationName}" Style="{StaticResource T.Base}" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding StationSub}" Style="{StaticResource T.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding ChooseStation, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Station" Style="{StaticResource T.Label}"/>
                        <ComboBox ItemsSource="{Binding AvailableStations}" SelectedItem="{Binding Station}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  ·  " Foreground="{DynamicResource Text.Faint}"/><Run Text="{Binding Location, Mode=OneWay}" Foreground="{DynamicResource Text.Muted}"/></TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Margin="26,22">
                <!-- Customer -->
                <TextBlock Style="{StaticResource T.Label}" FontSize="12" Margin="0,0,0,8"><Run Text="Customer"/> <Run Text="(optional)" Foreground="{DynamicResource Text.Faint}"/></TextBlock>
                <parts:CustomerPicker DataContext="{Binding Customer}"/>

                <!-- Controllers (stations priced per controller) -->
                <StackPanel Visibility="{Binding HasControllerPricing, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource T.Label}" FontSize="12" Margin="0,20,0,8"><Run Text="Controllers"/> <Run Text="· extra controllers add to the hourly price" Foreground="{DynamicResource Text.Faint}"/></TextBlock>
                    <ListBox Style="{StaticResource OptionList}" ItemsSource="{Binding ControllerOptions}" SelectedValuePath="Count" SelectedValue="{Binding Controllers}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <c:Icon Data="{StaticResource I.Gamepad}" Width="16" Height="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Count}" FontFamily="{DynamicResource Font.Mono}" FontSize="18" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding PriceNote}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- Mode -->
                <TextBlock Text="Session mode" Style="{StaticResource T.Label}" FontSize="12" Margin="0,20,0,8"/>
                <UniformGrid Columns="3" Margin="-5,0">
                    <RadioButton Style="{StaticResource OptionCard}" Margin="5,0" GroupName="Mode" c:Ui.FocusOnLoad="True"
                                 IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Open}">
                        <StackPanel>
                            <TextBlock Text="Play freely" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Pay for actual time. Timer counts up." Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap" TextTrimming="None" LineHeight="16" Margin="0,4,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource OptionCard}" Margin="5,0" GroupName="Mode"
                                 IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=FixedDuration}">
                        <StackPanel>
                            <TextBlock Text="Fixed duration" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Choose hours. Alert when time is up." Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap" TextTrimming="None" LineHeight="16" Margin="0,4,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource OptionCard}" Margin="5,0" GroupName="Mode"
                                 IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=FixedBudget}">
                        <StackPanel>
                            <TextBlock Text="Fixed budget" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Customer sets an amount. Play time is computed." Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap" TextTrimming="None" LineHeight="16" Margin="0,4,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>

                <!-- Fixed duration -->
                <Grid Margin="0,20,0,0" Visibility="{Binding Mode, Converter={StaticResource EqualsToVis}, ConverterParameter=FixedDuration}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Duration" Style="{StaticResource T.Label}" FontSize="12" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Big}" BorderBrush="{DynamicResource Accent}" c:Ui.Suffix="min" c:Ui.SelectAllOnFocus="True"/>
                        <ItemsControl ItemsSource="{Binding DurationPresets}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Content="{Binding Label}" Style="{StaticResource Preset}" Command="{Binding DataContext.SetDurationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Value}"/>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Price" Style="{StaticResource T.Label}" FontSize="12" Margin="0,0,0,8"/>
                        <Border Height="52" CornerRadius="8" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="14,0">
                            <TextBlock Text="{Binding FixedPriceText}" Style="{StaticResource T.MonoStrong}" FontSize="22" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding FixedEndText}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Fixed budget -->
                <Grid Margin="0,20,0,0" Visibility="{Binding Mode, Converter={StaticResource EqualsToVis}, ConverterParameter=FixedBudget}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Budget" Style="{StaticResource T.Label}" FontSize="12" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding BudgetText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Big}" BorderBrush="{DynamicResource Accent}"
                                 c:Ui.Suffix="{x:Static cm:Money.CurrencySymbol}" c:Ui.SelectAllOnFocus="True"/>
                        <ItemsControl ItemsSource="{Binding BudgetPresets}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Content="{Binding Label}" Style="{StaticResource Preset}" Command="{Binding DataContext.SetBudgetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Value}"/>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Maximum play time" Style="{StaticResource T.Label}" FontSize="12" Margin="0,0,0,8"/>
                        <Border Height="52" CornerRadius="8" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="14,0">
                            <DockPanel VerticalAlignment="Center">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding MaxTimeHint}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MaxTimeText}" Style="{StaticResource T.MonoStrong}" FontSize="22"/>
                            </DockPanel>
                        </Border>
                        <TextBlock Text="{Binding WarningHint}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding Error}" Style="{StaticResource T.Error}" Margin="0,14,0,0"/>
            </StackPanel>

            <!-- Footer -->
            <Border Style="{StaticResource DialogFooter}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Cancel" Style="{StaticResource Btn.Secondary}" Height="42" Padding="18,0" Command="{Binding CancelCommand}" Margin="0,0,10,0" IsCancel="True"/>
                        <Button Content="Start session" Style="{StaticResource Btn.Primary}" Height="42" Padding="22,0" Command="{Binding StartCommand}" IsDefault="True"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StartsNow}" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
