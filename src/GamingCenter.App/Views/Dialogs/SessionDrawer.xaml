<UserControl x:Class="GamingCenter.App.Views.Dialogs.SessionDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls"
             xmlns:parts="clr-namespace:GamingCenter.App.Views.Parts">
    <!-- Design 1f: right drawer -->
    <Border Width="1040" Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1,0,0,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="80" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Left: session ===== -->
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="28,26,28,20" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource Dot}" Fill="{Binding StatusBrush, Converter={StaticResource StatusBrush}}"/>
                                <TextBlock Text="{Binding StatusLine}" Margin="8,0,0,0" FontFamily="{DynamicResource Font.UI}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding StatusBrush, Converter={StaticResource StatusBrush}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding StationName}" Style="{StaticResource T.Base}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource T.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <Border DockPanel.Dock="Bottom" Padding="28,20" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <UniformGrid Columns="2" Margin="-5,0">
                                <Button Style="{StaticResource Btn.Secondary}" Height="44" Margin="5,0" Command="{Binding TogglePauseCommand}" IsEnabled="{Binding IsStopped, Converter={StaticResource Equals}, ConverterParameter=False}">
                                    <TextBlock Text="{Binding PauseButtonText}"/>
                                </Button>
                                <Button Content="Extend / change mode" Style="{StaticResource Btn.Secondary}" Height="44" Margin="5,0" Command="{Binding ExtendCommand}"/>
                            </UniformGrid>
                            <Button Content="End session &amp; bill" Style="{StaticResource Btn.Danger}" Height="46" Margin="0,10,0,0" Command="{Binding EndAndBillCommand}"/>
                            <DockPanel Margin="0,12,0,0">
                                <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource Btn.Link}" Command="{Binding CancelCommand}"/>
                                <Button Content="Cancel session (no charge)" Style="{StaticResource Btn.Link}" HorizontalAlignment="Left" Command="{Binding CancelSessionCommand}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Timer and running total -->
                            <Border Padding="28" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="{Binding TimerLabel}" Style="{StaticResource T.Muted}"/>
                                    <TextBlock Text="{Binding TimerText}" Style="{StaticResource T.MonoStrong}" FontSize="52" Margin="0,4,0,0"
                                               Foreground="{Binding TimerBrush, Converter={StaticResource StatusBrush}}"/>
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Margin="0,10,0,0" Foreground="{Binding TimerBrush, Converter={StaticResource StatusBrush}}"
                                                 Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding ModeDetail}" Style="{StaticResource T.Faint}" Margin="0,8,0,0"/>
                                    <Border Style="{StaticResource Notice.Info}" Padding="12,10" Margin="0,12,0,0" Visibility="{Binding CanChangeControllers, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Content="−" Style="{StaticResource Btn.Qty}" Width="28" Height="28" ToolTip="Remove a controller" Command="{Binding RemoveControllerCommand}"/>
                                                    <Button Content="+" Style="{StaticResource Btn.Qty}" Width="28" Height="28" Margin="8,0,0,0" ToolTip="Add a controller (price goes up from now)" Command="{Binding AddControllerCommand}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <c:Icon Data="{StaticResource I.Gamepad}" Width="16" Height="16" Foreground="{DynamicResource Accent}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding ControllersText}" Style="{StaticResource T.Base}" FontWeight="SemiBold"/>
                                                    <TextBlock Style="{StaticResource T.Mono}" FontSize="12" Foreground="{DynamicResource Text.Muted}" Margin="10,0,0,0" VerticalAlignment="Center"><Run Text="{Binding Session.HourlyRate, Mode=OneWay, Converter={StaticResource Money}}"/><Run Text="/h"/></TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="{Binding ControllersNote}" Style="{StaticResource T.Faint}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <DockPanel Margin="0,14,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding GamingText}" Style="{StaticResource T.MonoStrong}" FontSize="18"/>
                                        <TextBlock Text="{Binding GamingLabel}" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ConsumptionText}" Style="{StaticResource T.MonoStrong}" FontSize="18"/>
                                        <TextBlock Text="Consumption" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Rectangle Height="1" Stroke="{DynamicResource Border}" StrokeDashArray="4 3" Margin="0,10,0,10"/>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" Style="{StaticResource T.MonoStrong}" FontSize="22" Foreground="{DynamicResource Accent}"/>
                                        <TextBlock Text="Running total" Style="{StaticResource T.Base}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Pauses -->
                            <Border Padding="28,22" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="Pauses" Style="{StaticResource T.Muted}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <TextBlock Text="No pauses" Style="{StaticResource T.Faint}" Visibility="{Binding Pauses.Count, Converter={StaticResource NoValueToVis}}"/>
                                    <ItemsControl ItemsSource="{Binding Pauses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}" Style="{StaticResource T.Mono}" FontSize="12"/>
                                                    <TextBlock Text="{Binding Range}" Style="{StaticResource T.Mono}" FontSize="12" Foreground="{DynamicResource Text.Muted}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding PauseSummary}" Style="{StaticResource T.Faint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Items -->
                            <StackPanel Margin="28,22">
                                <TextBlock Text="Items" Style="{StaticResource T.Muted}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock Text="No products yet. Click a product on the right to add it." Style="{StaticResource T.Faint}" TextWrapping="Wrap"
                                           Visibility="{Binding Lines.Count, Converter={StaticResource NoValueToVis}}"/>
                                <ItemsControl ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,10">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Content="−" Style="{StaticResource Btn.Qty}" Command="{Binding DataContext.DecreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    <Button Content="+" Style="{StaticResource Btn.Qty}" Margin="8,0,0,0" Command="{Binding DataContext.IncreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    <TextBlock Text="{Binding Total}" Style="{StaticResource T.Mono}" FontWeight="Medium" Width="80" TextAlignment="Right" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource T.Base}" VerticalAlignment="Center"><Run Text="{Binding Name, Mode=OneWay}"/> <Run Text="×" Foreground="{DynamicResource Text.Muted}"/><Run Text="{Binding Quantity, Mode=OneWay}" Foreground="{DynamicResource Text.Muted}"/></TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Error}" Style="{StaticResource T.Error}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===== Right: catalog ===== -->
            <DockPanel Grid.Column="1" Margin="28,26,28,28">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="34" Height="34" MinHeight="0" c:Ui.Icon="{StaticResource I.X}" Command="{Binding CancelCommand}" ToolTip="Close (Esc)"/>
                    <TextBlock Text="Add consumption" Style="{StaticResource T.Base}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <parts:ProductCatalog DataContext="{Binding Catalog}"/>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
