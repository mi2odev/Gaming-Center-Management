<UserControl x:Class="GamingCenter.App.Views.Dialogs.RoomsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls">
    <Border Style="{StaticResource DialogCard}" Width="520" MaxHeight="680">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource DialogHeader}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="34" Height="34" MinHeight="0" c:Ui.Icon="{StaticResource I.X}" Command="{Binding CancelCommand}"/>
                    <StackPanel>
                        <TextBlock Text="Rooms" Style="{StaticResource T.Base}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Rename a room and its stations follow. Deleting a room asks where its stations go." Style="{StaticResource T.Muted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                            <Button Content="Cancel" Style="{StaticResource Btn.Link}" Margin="0,0,12,0" Command="{Binding NewCommand}"
                                    Visibility="{Binding EditId, Converter={StaticResource HasValueToVis}}"/>
                            <Button Style="{StaticResource Btn.Primary}" Command="{Binding SaveCommand}" Content="{Binding SaveText}" IsDefault="True"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Room name" Style="{StaticResource T.Label}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="e.g. VIP room" c:Ui.FocusOnLoad="True"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding Error}" Style="{StaticResource T.Error}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Error, Converter={StaticResource HasValueToVis}}"/>
                </StackPanel>
            </Border>
            <Grid>
                <TextBlock Text="No rooms yet. Add one below." Style="{StaticResource T.Muted}" Margin="26,20"
                           Visibility="{Binding Rooms.Count, Converter={StaticResource NoValueToVis}}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,10">
                    <ItemsControl ItemsSource="{Binding Rooms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Row.Divider}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Rename" Style="{StaticResource Btn.Link}" Margin="0,0,14,0" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Button Content="Delete" Style="{StaticResource Btn.LinkDanger}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                        <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Bg.Placeholder}" Margin="0,0,12,0">
                                            <c:Icon Data="{StaticResource I.Grid}" Width="15" Height="15" Foreground="{DynamicResource Text.Faint}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}" FontWeight="Medium"/>
                                            <TextBlock Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}">
                                                <Run Text="{Binding StationCount, Mode=OneWay}"/><Run Text=" stations"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
