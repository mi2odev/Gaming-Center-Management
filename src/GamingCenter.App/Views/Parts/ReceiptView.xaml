<UserControl x:Class="GamingCenter.App.Views.Parts.ReceiptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: ReceiptPreview. Thermal-receipt look from design 1j. -->
    <UserControl.Resources>
        <Style x:Key="P" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="Foreground" Value="{DynamicResource Paper.Text}"/>
        </Style>
        <Style x:Key="PC" TargetType="TextBlock" BasedOn="{StaticResource P}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Paper.Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Rule" TargetType="Rectangle">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Stroke" Value="#999999"/>
            <Setter Property="StrokeDashArray" Value="4 3"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource Paper}" CornerRadius="6" Padding="20,22">
        <StackPanel>
            <TextBlock Text="{Binding CenterName}" FontFamily="{DynamicResource Font.UI}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Paper.Text}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Contact}" Style="{StaticResource PC}" Visibility="{Binding Contact, Converter={StaticResource HasValueToVis}}"/>
            <TextBlock Text="{Binding Stamp}" Style="{StaticResource PC}" Margin="0,0,0,10"/>
            <Rectangle Style="{StaticResource Rule}"/>
            <StackPanel Visibility="{Binding IsGaming, Converter={StaticResource BoolToVis}}">
                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Station}" Style="{StaticResource P}"/><TextBlock Text="Station" Style="{StaticResource P}"/></DockPanel>
                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding SessionRange}" Style="{StaticResource P}"/><TextBlock Text="Session" Style="{StaticResource P}"/></DockPanel>
                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding PlayTime}" Style="{StaticResource P}"/><TextBlock Text="Play time" Style="{StaticResource P}"/></DockPanel>
                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Gaming}" Style="{StaticResource P}"/><TextBlock Text="{Binding GamingLabel}" Style="{StaticResource P}"/></DockPanel>
                <TextBlock Text="{Binding RateNote}" Style="{StaticResource P}" FontSize="11" Foreground="{DynamicResource Paper.Muted}" TextWrapping="Wrap" Visibility="{Binding RateNote, Converter={StaticResource HasValueToVis}}"/>
                <Rectangle Style="{StaticResource Rule}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding LineTotal, Converter={StaticResource Money}, ConverterParameter=number}" Style="{StaticResource P}"/>
                            <TextBlock Style="{StaticResource P}" TextTrimming="CharacterEllipsis"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" x"/><Run Text="{Binding Quantity, Mode=OneWay}"/></TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Rectangle Style="{StaticResource Rule}" Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}"/>
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Total}" Style="{StaticResource P}" FontWeight="Bold" FontSize="14"/>
                <TextBlock Text="TOTAL" Style="{StaticResource P}" FontWeight="Bold" FontSize="14"/>
            </DockPanel>
            <DockPanel Visibility="{Binding IsSingle, Converter={StaticResource BoolToVis}}"><TextBlock DockPanel.Dock="Right" Text="{Binding Received}" Style="{StaticResource P}"/><TextBlock Text="{Binding Method}" Style="{StaticResource P}"/></DockPanel>
            <ItemsControl ItemsSource="{Binding Parts}" Visibility="{Binding IsSplit, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Amount, Converter={StaticResource Money}, ConverterParameter=number}" Style="{StaticResource P}"/>
                            <TextBlock Text="{Binding Method}" Style="{StaticResource P}"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Visibility="{Binding HasChange, Converter={StaticResource BoolToVis}}"><TextBlock DockPanel.Dock="Right" Text="{Binding Change}" Style="{StaticResource P}"/><TextBlock Text="Change" Style="{StaticResource P}"/></DockPanel>
            <DockPanel Visibility="{Binding HasCredit, Converter={StaticResource BoolToVis}}"><TextBlock DockPanel.Dock="Right" Text="{Binding CreditAmount}" Style="{StaticResource P}" FontWeight="Bold"/><TextBlock Text="On credit (unpaid)" Style="{StaticResource P}" FontWeight="Bold"/></DockPanel>
            <DockPanel Visibility="{Binding HasBalance, Converter={StaticResource BoolToVis}}"><TextBlock DockPanel.Dock="Right" Text="{Binding CustomerBalance}" Style="{StaticResource P}"/><TextBlock Text="Total owed now" Style="{StaticResource P}"/></DockPanel>
            <DockPanel Visibility="{Binding Customer, Converter={StaticResource HasValueToVis}}"><TextBlock DockPanel.Dock="Right" Text="{Binding Customer}" Style="{StaticResource P}"/><TextBlock Text="Customer" Style="{StaticResource P}"/></DockPanel>
            <TextBlock Text="{Binding Footer}" Style="{StaticResource PC}" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
