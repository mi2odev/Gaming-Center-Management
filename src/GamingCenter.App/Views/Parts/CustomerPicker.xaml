<UserControl x:Class="GamingCenter.App.Views.Parts.CustomerPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls">
    <!-- DataContext: CustomerPickerViewModel -->
    <Grid>
        <!-- Selected customer chip -->
        <Border Height="42" CornerRadius="8" Background="{DynamicResource Accent.Soft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Padding="14,0"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <DockPanel VerticalAlignment="Center">
                <Button DockPanel.Dock="Right" Content="Walk-in instead" Style="{StaticResource Btn.Link}" Command="{Binding ClearCommand}"/>
                <Border DockPanel.Dock="Right" Background="{DynamicResource Warning.Soft}" BorderBrush="{DynamicResource Warning.Border}" BorderThickness="1" CornerRadius="999" Padding="8,2" Margin="0,0,10,0"
                        VerticalAlignment="Center" Visibility="{Binding DebtLabel, Converter={StaticResource HasValueToVis}}" ToolTip="Unpaid credit — see the Credits page">
                    <TextBlock Text="{Binding DebtLabel}" Style="{StaticResource T.Base}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Warning}"/>
                </Border>
                <c:Icon Data="{StaticResource I.Users}" Width="15" Height="15" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding SelectedLabel}" Style="{StaticResource T.Base}" FontWeight="Medium"/>
            </DockPanel>
        </Border>

        <!-- Search box -->
        <Grid x:Name="Host" Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}">
            <TextBox x:Name="Box" Height="42" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="14,0,70,0"
                     c:Ui.Placeholder="Walk-in — type a name or phone to attach a customer"/>
            <Button Content="+ New" Style="{StaticResource Btn.LinkAccent}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,14,0" Command="{Binding CreateNewCommand}"/>
            <Popup IsOpen="{Binding IsOpen}" PlacementTarget="{Binding ElementName=Box}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                   Width="{Binding ActualWidth, ElementName=Host}">
                <Border Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,0,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Suggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Btn.Link}" HorizontalContentAlignment="Stretch" Padding="12,8" FontSize="13"
                                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <DockPanel Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Phone}" Style="{StaticResource T.Mono}" FontSize="12" Foreground="{DynamicResource Text.Muted}" Margin="0,0,24,0"/>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource Btn.LinkAccent}" HorizontalContentAlignment="Left" Padding="12,8" Command="{Binding CreateNewCommand}">
                            <TextBlock>
                                <Run Text="+ Create customer"/>
                                <Run Text="{Binding SearchText, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</UserControl>
