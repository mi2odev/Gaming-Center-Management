<UserControl x:Class="GamingCenter.App.Views.Parts.ProductCatalog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls"
             xmlns:parts="clr-namespace:GamingCenter.App.Views.Parts">
    <!-- DataContext: ProductCatalogViewModel -->
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid DockPanel.Dock="Right" Width="200">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Find product…" Height="34" Padding="32,0,10,0"/>
                <c:Icon Data="{StaticResource I.Search}" Width="14" Height="14" Foreground="{DynamicResource Text.Faint}" HorizontalAlignment="Left" Margin="11,0,0,0"/>
            </Grid>
            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"/>
        </DockPanel>

        <Grid>
            <TextBlock Text="No products. Add products on the Products page." Style="{StaticResource T.Muted}" HorizontalAlignment="Center" Margin="0,40,0,0"
                       Visibility="{Binding Visible.Count, Converter={StaticResource NoValueToVis}}"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Visible}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><c:ResponsiveGrid MinItemWidth="140" Gap="12"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Tile" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10"
                                    c:Ui.ClickCommand="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" c:Ui.ClickParameter="{Binding}"
                                    ToolTip="Click to add one">
                                <Grid>
                                    <StackPanel>
                                        <Border CornerRadius="10,10,0,0" ClipToBounds="True">
                                            <parts:Thumb Height="80" ImagePath="{Binding ImagePath}" TagText="{Binding CategoryTag}" TagSize="11" CornerRadius="10,10,0,0"/>
                                        </Border>
                                        <StackPanel Margin="12,10,12,12">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}" FontWeight="Medium"/>
                                            <DockPanel Margin="0,4,0,0">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding StockLabel}" FontSize="11" VerticalAlignment="Bottom">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource T.Faint}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLow}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsOut}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding PriceText}" Style="{StaticResource T.MonoStrong}" FontSize="14"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" MinWidth="22" Height="22" CornerRadius="11" Padding="7,0"
                                            Background="{DynamicResource Accent}" Visibility="{Binding InCart, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Quantity}" Style="{StaticResource T.MonoStrong}" FontSize="12" Foreground="{DynamicResource Accent.Fg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsOut}" Value="True">
                                    <Setter TargetName="Tile" Property="Opacity" Value="0.45"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
