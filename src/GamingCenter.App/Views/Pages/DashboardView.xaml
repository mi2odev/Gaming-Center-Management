<UserControl x:Class="GamingCenter.App.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls"
             xmlns:parts="clr-namespace:GamingCenter.App.Views.Parts"
             x:Name="Root">
    <UserControl.Resources>
        <!-- Right-click menu shared by cards and rows. DataContext = StationCardViewModel, Tag of target = DashboardViewModel -->
        <ContextMenu x:Key="StationMenu" x:Shared="False">
            <MenuItem Header="Open session" Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"
                      Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="Start session" Command="{Binding PlacementTarget.Tag.StartCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"
                      Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="Pause / resume" Command="{Binding PlacementTarget.Tag.PauseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"
                      Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="Add product" Command="{Binding PlacementTarget.Tag.AddProductCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"
                      Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="End session &amp; bill" Command="{Binding PlacementTarget.Tag.EndCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"
                      Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="Reserve…" Command="{Binding PlacementTarget.Tag.ReserveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"
                      Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="Clear reservation" Command="{Binding PlacementTarget.Tag.ClearReservationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"
                      Visibility="{Binding IsReserved, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="Set to maintenance" Command="{Binding PlacementTarget.Tag.MaintenanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"
                      Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="Back in service" Command="{Binding PlacementTarget.Tag.BackInServiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"
                      Visibility="{Binding IsMaintenance, Converter={StaticResource BoolToVis}}"/>
        </ContextMenu>

        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource T.Muted}"/>
        <Style x:Key="StatSub" TargetType="TextBlock" BasedOn="{StaticResource T.Muted}">
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="StatUnit" TargetType="Run">
            <Setter Property="FontFamily" Value="{DynamicResource Font.UI}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
        </Style>

        <!-- Status pill used on cards -->
        <DataTemplate x:Key="StatusPill">
            <Border Style="{StaticResource Pill}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource Dot}" Fill="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Status.}"/>
                    <TextBlock Text="{Binding StatusLabel}" Margin="6,0,0,0" FontFamily="{DynamicResource Font.UI}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Status.}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,24,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Today strip ===== -->
        <UniformGrid Rows="1" Columns="6" Margin="-7,0,-7,22">
            <UniformGrid.Resources>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Margin" Value="7,0"/>
                </Style>
            </UniformGrid.Resources>
            <Border>
                <StackPanel>
                    <TextBlock Text="Today's revenue" Style="{StaticResource StatLabel}"/>
                    <TextBlock Style="{StaticResource T.StatValue}"><Run Text="{Binding RevenueText, Mode=OneWay}"/> <Run Text="{Binding Currency, Mode=OneWay}" Style="{StaticResource StatUnit}"/></TextBlock>
                    <TextBlock Text="{Binding RevenueTrend}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatSub}">
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RevenueTrendUp}" Value="False"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding RevenueNote}" Style="{StaticResource StatSub}" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap"
                               Visibility="{Binding RevenueNote, Converter={StaticResource HasValueToVis}}"
                               ToolTip="Money received today: payments at the till plus credit paid back. The unpaid part of a bill counts when it is paid."/>
                </StackPanel>
            </Border>
            <Border>
                <StackPanel>
                    <TextBlock Text="Gaming" Style="{StaticResource StatLabel}"/>
                    <TextBlock Style="{StaticResource T.StatValue}"><Run Text="{Binding GamingText, Mode=OneWay}"/> <Run Text="{Binding Currency, Mode=OneWay}" Style="{StaticResource StatUnit}"/></TextBlock>
                    <TextBlock Text="{Binding GamingSub}" Style="{StaticResource StatSub}"/>
                </StackPanel>
            </Border>
            <Border>
                <StackPanel>
                    <TextBlock Text="Products" Style="{StaticResource StatLabel}"/>
                    <TextBlock Style="{StaticResource T.StatValue}"><Run Text="{Binding ProductsText, Mode=OneWay}"/> <Run Text="{Binding Currency, Mode=OneWay}" Style="{StaticResource StatUnit}"/></TextBlock>
                    <TextBlock Text="{Binding ProductsSub}" Style="{StaticResource StatSub}"/>
                </StackPanel>
            </Border>
            <Border>
                <StackPanel>
                    <TextBlock Text="Active sessions" Style="{StaticResource StatLabel}"/>
                    <TextBlock Style="{StaticResource T.StatValue}"><Run Text="{Binding CountOccupied, Mode=OneWay}"/> <Run Style="{StaticResource StatUnit}" Text="/"/><Run Style="{StaticResource StatUnit}" Text=" "/><Run Text="{Binding CountAll, Mode=OneWay}" Style="{StaticResource StatUnit}"/></TextBlock>
                    <TextBlock Text="{Binding ActiveSub}" Style="{StaticResource StatSub}"/>
                </StackPanel>
            </Border>
            <Border>
                <StackPanel>
                    <TextBlock Text="Most used today" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding MostUsed}" Style="{StaticResource T.Base}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding MostUsedSub}" Style="{StaticResource StatSub}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border c:Ui.ClickCommand="{Binding GoLowStockCommand}" ToolTip="Open low-stock products">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Margin" Value="7,0"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Warning.Border}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LowStockCount}" Value="0">
                                <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Low stock" Style="{StaticResource StatLabel}" Foreground="{DynamicResource Warning}"/>
                    <TextBlock Text="{Binding LowStockCount}" Style="{StaticResource T.StatValue}" Foreground="{DynamicResource Warning}"/>
                    <TextBlock Text="{Binding LowStockSub}" Style="{StaticResource StatSub}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ===== Filters ===== -->
        <DockPanel Grid.Row="1" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Sort" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Style="{StaticResource SegmentHost}" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Sort" Content="Room" IsChecked="{Binding Sort, Converter={StaticResource Equals}, ConverterParameter=Room}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Sort" Content="Type" IsChecked="{Binding Sort, Converter={StaticResource Equals}, ConverterParameter=Type}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Sort" Content="Status" IsChecked="{Binding Sort, Converter={StaticResource Equals}, ConverterParameter=Status}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="View" Content="Grid" c:Ui.Icon="{StaticResource I.Grid}" IsChecked="{Binding ViewMode, Converter={StaticResource Equals}, ConverterParameter=Grid}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="View" Content="List" c:Ui.Icon="{StaticResource I.List}" IsChecked="{Binding ViewMode, Converter={StaticResource Equals}, ConverterParameter=List}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Stations" Style="{StaticResource T.Section}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Border Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Filter" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=All}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="All" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource CountBadge}"><TextBlock Text="{Binding CountAll}" Style="{StaticResource T.Mono}" FontSize="11" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Filter" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Available}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource Dot}" Fill="{DynamicResource Status.Available}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Available" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource CountBadge}"><TextBlock Text="{Binding CountAvailable}" Style="{StaticResource T.Mono}" FontSize="11" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Filter" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Occupied}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource Dot}" Fill="{DynamicResource Status.Occupied}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Occupied" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource CountBadge}"><TextBlock Text="{Binding CountOccupied}" Style="{StaticResource T.Mono}" FontSize="11" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Filter" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Reserved}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource Dot}" Fill="{DynamicResource Status.Reserved}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Reserved" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource CountBadge}"><TextBlock Text="{Binding CountReserved}" Style="{StaticResource T.Mono}" FontSize="11" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Filter" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Offline}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource Dot}" Fill="{DynamicResource Status.Offline}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Offline" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource CountBadge}"><TextBlock Text="{Binding CountOffline}" Style="{StaticResource T.Mono}" FontSize="11" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Border>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- ===== Empty state ===== -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <c:Icon Data="{StaticResource I.Gamepad}" Width="40" Height="40" Foreground="{DynamicResource Text.Faint}"/>
            <TextBlock Text="No gaming stations yet" Style="{StaticResource T.Section}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
            <TextBlock Text="An administrator can add PS4, PS5, PCs or any other station on the Gaming Stations page." Style="{StaticResource T.Muted}" HorizontalAlignment="Center"/>
            <Button Content="Go to Gaming Stations" Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Center" Margin="0,16,0,0" Command="{Binding GoStationsCommand}"/>
        </StackPanel>

        <!-- ===== Grid view (1a) ===== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,0,32"
                      Visibility="{Binding ViewMode, Converter={StaticResource EqualsToVis}, ConverterParameter=Grid}">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><c:ResponsiveGrid MinItemWidth="260" Gap="16"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CardBd" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12"
                                c:Ui.ClickCommand="{Binding DataContext.OpenCommand, ElementName=Root}" c:Ui.ClickParameter="{Binding}"
                                Tag="{Binding DataContext, ElementName=Root}" ContextMenu="{StaticResource StationMenu}">
                            <StackPanel>
                                <Grid Height="124">
                                    <Border CornerRadius="11,11,0,0" ClipToBounds="True">
                                        <parts:Thumb ImagePath="{Binding ImagePath}" TagText="{Binding Tag}" CornerRadius="11,11,0,0"/>
                                    </Border>
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusPill}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"/>
                                    <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="8,4">
                                        <TextBlock Text="{Binding RateLabel}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{DynamicResource Text.Muted}"/>
                                    </Border>
                                </Grid>
                                <StackPanel Margin="16,14,16,16">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource T.H15}"/>
                                    <TextBlock Text="{Binding TypeLine}" Style="{StaticResource T.Muted}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding TimerText}" Style="{StaticResource T.MonoStrong}" FontSize="30" Margin="0,10,0,6"
                                               Foreground="{Binding TimerBrush, Converter={StaticResource StatusBrush}}"/>
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Margin="0,2,0,8" Foreground="{Binding ProgressBrush, Converter={StaticResource StatusBrush}}"
                                                 Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}"/>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CostText}" Style="{StaticResource T.MonoStrong}" FontSize="15" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding Line}" Style="{StaticResource T.Muted}" VerticalAlignment="Bottom"/>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="CardBd" Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBd" Property="BorderBrush" Value="{DynamicResource Border.Dashed}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsEndingSoon}" Value="True">
                                <Setter TargetName="CardBd" Property="BorderBrush" Value="{DynamicResource Warning}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                <Setter TargetName="CardBd" Property="Opacity" Value="0.7"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ===== List view (1c) ===== -->
        <DockPanel Grid.Row="2" Visibility="{Binding ViewMode, Converter={StaticResource EqualsToVis}, ConverterParameter=List}">
            <Grid DockPanel.Dock="Top" Margin="16,0,24,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="STATION" Style="{StaticResource T.ColumnHeader}" Margin="16,0,0,0"/>
                <TextBlock Grid.Column="2" Text="TYPE · ROOM" Style="{StaticResource T.ColumnHeader}"/>
                <TextBlock Grid.Column="3" Text="CUSTOMER / MODE" Style="{StaticResource T.ColumnHeader}"/>
                <TextBlock Grid.Column="4" Text="TIMER" Style="{StaticResource T.ColumnHeader}"/>
                <TextBlock Grid.Column="5" Text="PROGRESS" Style="{StaticResource T.ColumnHeader}"/>
                <TextBlock Grid.Column="6" Text="COST" Style="{StaticResource T.ColumnHeader}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="7" Text="ACTIONS" Style="{StaticResource T.ColumnHeader}" HorizontalAlignment="Right"/>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,24">
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RowBd" Height="54" Margin="0,0,8,6" Padding="16,0" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10"
                                    c:Ui.ClickCommand="{Binding DataContext.OpenCommand, ElementName=Root}" c:Ui.ClickParameter="{Binding}"
                                    Tag="{Binding DataContext, ElementName=Root}" ContextMenu="{StaticResource StationMenu}">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Fill="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Status.}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,8,0">
                                        <Border Width="34" Height="34" CornerRadius="6" ClipToBounds="True">
                                            <parts:Thumb ImagePath="{Binding ImagePath}" TagText="{Binding Tag}" TagSize="10" CornerRadius="6"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding TypeLine}" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Line}" Style="{StaticResource T.Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="4" Text="{Binding TimerText}" Style="{StaticResource T.MonoStrong}" FontSize="22" VerticalAlignment="Center"
                                               Foreground="{Binding TimerBrush, Converter={StaticResource StatusBrush}}"/>
                                    <ProgressBar Grid.Column="5" Height="5" Value="{Binding Progress, Mode=OneWay}" Margin="0,0,16,0" Foreground="{Binding ProgressBrush, Converter={StaticResource StatusBrush}}"
                                                 Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Grid.Column="6" Text="{Binding CostText}" Style="{StaticResource T.MonoStrong}" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                            <Button Style="{StaticResource Btn.Small}" Margin="0,0,6,0" Command="{Binding DataContext.PauseCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                    Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}">
                                                <Button.Content>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Pause"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPaused}" Value="True"><Setter Property="Text" Value="Resume"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button.Content>
                                            </Button>
                                            <Button Content="+ Product" Style="{StaticResource Btn.Small}" Margin="0,0,6,0" Command="{Binding DataContext.AddProductCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                            <Button Content="End" Style="{StaticResource Btn.SmallDanger}" Command="{Binding DataContext.EndCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                        <Button Content="Start" Style="{StaticResource Btn.SmallPrimary}" Padding="14,0" Command="{Binding DataContext.StartCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="RowBd" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBd" Property="BorderBrush" Value="{DynamicResource Border.Dashed}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsEndingSoon}" Value="True">
                                    <Setter TargetName="RowBd" Property="BorderBrush" Value="{DynamicResource Warning}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
