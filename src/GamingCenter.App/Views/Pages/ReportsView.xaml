<UserControl x:Class="GamingCenter.App.Views.Pages.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls"
             xmlns:cm="clr-namespace:GamingCenter.Application.Common;assembly=GamingCenter.Application">
    <UserControl.Resources>
        <!-- Horizontal bar with a label, value and small detail line -->
        <DataTemplate x:Key="BarRow">
            <StackPanel Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource T.MonoStrong}" FontSize="12"/>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}" FontSize="12"/>
                </DockPanel>
                <Border Height="6" CornerRadius="3" Background="{DynamicResource Border}" Margin="0,5,0,0" ClipToBounds="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionStar}}"/>
                            <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionStar}, ConverterParameter=rest}"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource Accent}" CornerRadius="3"/>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Sub}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,0"
                           Visibility="{Binding Sub, Converter={StaticResource HasValueToVis}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Simple column for hour / weekday charts -->
        <DataTemplate x:Key="ColumnBar">
            <Grid Margin="2,0" ToolTip="{Binding Value}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding Height, Converter={StaticResource FractionStar}, ConverterParameter=rest}"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{Binding Height, Converter={StaticResource FractionStar}}"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="1" Text="{Binding Value}" Style="{StaticResource T.Mono}" FontSize="10" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <Border Grid.Row="2" Background="{DynamicResource Accent}" CornerRadius="4,4,0,0" MaxWidth="48" MinHeight="2"/>
                <TextBlock Grid.Row="3" Text="{Binding Label}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="KpiValue" TargetType="TextBlock" BasedOn="{StaticResource T.StatValue}">
            <Setter Property="FontSize" Value="24"/>
        </Style>
    </UserControl.Resources>
    <!-- Design 1k -->
    <DockPanel Margin="32,24,32,0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="Export PDF" Style="{StaticResource Btn.Secondary}" c:Ui.Icon="{StaticResource I.Printer}" Margin="0,0,10,0" Command="{Binding ExportPdfCommand}"/>
                <Button Content="Export CSV" Style="{StaticResource Btn.Secondary}" c:Ui.Icon="{StaticResource I.Download}" Click="OnExportClick" ToolTip="Revenue, products or stations">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Revenue per day" Command="{Binding ExportCsvCommand}"/>
                            <MenuItem Header="Products" Command="{Binding ExportProductsCommand}"/>
                            <MenuItem Header="Station usage" Command="{Binding ExportStationsCommand}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="R" Content="Daily" IsChecked="{Binding Period, Converter={StaticResource Equals}, ConverterParameter=Day}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="R" Content="Weekly" IsChecked="{Binding Period, Converter={StaticResource Equals}, ConverterParameter=Week}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="R" Content="Monthly" IsChecked="{Binding Period, Converter={StaticResource Equals}, ConverterParameter=Month}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="R" Content="Yearly" IsChecked="{Binding Period, Converter={StaticResource Equals}, ConverterParameter=Year}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="R" Content="Custom…" IsChecked="{Binding Period, Converter={StaticResource Equals}, ConverterParameter=Custom}"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" Visibility="{Binding IsCustom, Converter={StaticResource InvBoolToVis}}">
                    <Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" MinHeight="0" c:Ui.Icon="{StaticResource I.ChevronLeft}" Command="{Binding PreviousCommand}" ToolTip="Previous period"/>
                    <Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" MinHeight="0" Margin="6,0,0,0" c:Ui.Icon="{StaticResource I.ChevronRight}" Command="{Binding NextCommand}" ToolTip="Next period"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                    <DatePicker SelectedDate="{Binding CustomFrom}" Width="130"/>
                    <TextBlock Text="→" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="8,0"/>
                    <DatePicker SelectedDate="{Binding CustomTo}" Width="130"/>
                </StackPanel>
                <TextBlock Text="{Binding RangeText}" Style="{StaticResource T.Mono}" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="None"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- KPIs -->
                <UniformGrid Grid.ColumnSpan="3" Rows="1" Columns="4" Margin="-8,0">
                    <Border Style="{StaticResource Card}" Margin="8,0" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="Total revenue" Style="{StaticResource T.Muted}" ToolTip="Money received: payments at the till plus credit paid back. The unpaid part of a bill counts on the day it is paid."/>
                            <TextBlock Style="{StaticResource T.StatValue}" FontSize="30"><Run Text="{Binding TotalText, Mode=OneWay}"/> <Run Text="{x:Static cm:Money.CurrencySymbol}" FontFamily="{DynamicResource Font.UI}" FontSize="13" Foreground="{DynamicResource Text.Muted}"/></TextBlock>
                            <TextBlock Text="{Binding TrendText}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Muted}">
                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding TrendUp}" Value="False"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding TotalNote}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Visibility="{Binding TotalNote, Converter={StaticResource HasValueToVis}}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="Gaming revenue" Style="{StaticResource T.Muted}"/>
                            <TextBlock Style="{StaticResource T.StatValue}" FontSize="30"><Run Text="{Binding GamingText, Mode=OneWay}"/> <Run Text="{x:Static cm:Money.CurrencySymbol}" FontFamily="{DynamicResource Font.UI}" FontSize="13" Foreground="{DynamicResource Text.Muted}"/></TextBlock>
                            <TextBlock Text="{Binding GamingShare}" Style="{StaticResource T.Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="Product revenue" Style="{StaticResource T.Muted}"/>
                            <TextBlock Style="{StaticResource T.StatValue}" FontSize="30"><Run Text="{Binding ProductText, Mode=OneWay}"/> <Run Text="{x:Static cm:Money.CurrencySymbol}" FontFamily="{DynamicResource Font.UI}" FontSize="13" Foreground="{DynamicResource Text.Muted}"/></TextBlock>
                            <TextBlock Text="{Binding ProfitText}" Style="{StaticResource T.Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="Sessions" Style="{StaticResource T.Muted}"/>
                            <TextBlock Text="{Binding SessionsText}" Style="{StaticResource T.StatValue}" FontSize="30"/>
                            <TextBlock Text="{Binding SessionsSub}" Style="{StaticResource T.Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Second KPI row -->
                <UniformGrid Grid.Row="2" Grid.ColumnSpan="3" Rows="1" Columns="6" Margin="-8,0">
                    <Border Style="{StaticResource Card}" Margin="8,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="Average ticket" Style="{StaticResource T.Muted}"/>
                            <TextBlock Text="{Binding AvgTicketText}" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="{Binding AvgTicketSub}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="Play hours" Style="{StaticResource T.Muted}"/>
                            <TextBlock Text="{Binding PlayHoursText}" Style="{StaticResource KpiValue}"/>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding OccupancyText}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{DynamicResource Text.Muted}" Margin="8,0,0,0"/>
                                <Border Height="6" CornerRadius="3" Background="{DynamicResource Border}" ClipToBounds="True" VerticalAlignment="Center"
                                        ToolTip="Occupancy: play time compared with the time all active stations were open in this period">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Occupancy, Converter={StaticResource FractionStar}}"/>
                                            <ColumnDefinition Width="{Binding Occupancy, Converter={StaticResource FractionStar}, ConverterParameter=rest}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource Info}" CornerRadius="3"/>
                                    </Grid>
                                </Border>
                            </DockPanel>
                            <TextBlock Text="occupancy" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="Customers" Style="{StaticResource T.Muted}"/>
                            <TextBlock Text="{Binding CustomersText}" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="{Binding CustomersSub}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="Counter sales" Style="{StaticResource T.Muted}"/>
                            <TextBlock Text="{Binding CounterText}" Style="{StaticResource KpiValue}"/>
                            <TextBlock Text="{Binding CounterSub}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="Discounts given" Style="{StaticResource T.Muted}"/>
                            <TextBlock Text="{Binding DiscountsText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource KpiValue}">
                                        <Style.Triggers><DataTrigger Binding="{Binding HasDiscounts}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="paid less than the bill" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="Left on credit" Style="{StaticResource T.Muted}"/>
                            <TextBlock Text="{Binding CreditText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource KpiValue}">
                                        <Style.Triggers><DataTrigger Binding="{Binding HasCredit}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding CreditSub}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Revenue per day -->
                <Border Grid.Row="4" Style="{StaticResource Card}" Padding="22,20">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                <TextBlock Text="Gaming" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" Margin="6,0,16,0"/>
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource Neutral}" VerticalAlignment="Center"/>
                                <TextBlock Text="Products" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ChartTitle}" Style="{StaticResource T.Section}"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Bars}" Height="300">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,0" ToolTip="{Binding Value}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="{Binding Height, Converter={StaticResource FractionStar}, ConverterParameter=rest}"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="{Binding Height, Converter={StaticResource FractionStar}}"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="1" Text="{Binding Value}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                        <Border Grid.Row="2" CornerRadius="6,6,0,0" ClipToBounds="True" MaxWidth="64">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="{Binding ProductShare, Converter={StaticResource FractionStar}}"/>
                                                    <RowDefinition Height="{Binding ProductShare, Converter={StaticResource FractionStar}, ConverterParameter=rest}"/>
                                                </Grid.RowDefinitions>
                                                <Border Background="{DynamicResource Neutral}" CornerRadius="6,6,0,0"/>
                                                <Border Grid.Row="1" Background="{DynamicResource Accent}"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Row="3" Text="{Binding Label}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- Revenue per station -->
                <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource Card}" Padding="22,20">
                    <StackPanel>
                        <TextBlock Text="Revenue per station" Style="{StaticResource T.Section}" Margin="0,0,0,14"/>
                        <TextBlock Text="No sessions in this period." Style="{StaticResource T.Muted}" Visibility="{Binding Stations.Count, Converter={StaticResource NoValueToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Stations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource T.MonoStrong}" FontSize="12"/>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}" FontSize="12"/>
                                        </DockPanel>
                                        <Border Height="6" CornerRadius="3" Background="{DynamicResource Border}" Margin="0,5,0,0" ClipToBounds="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionStar}}"/>
                                                    <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionStar}, ConverterParameter=rest}"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{DynamicResource Accent}" CornerRadius="3"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Top products -->
                <Border Grid.Row="8" Style="{StaticResource Card}" Padding="22,20">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="units · revenue · profit" Style="{StaticResource T.Muted}"/>
                            <TextBlock Text="Top products" Style="{StaticResource T.Section}"/>
                        </DockPanel>
                        <TextBlock Text="No product sales in this period." Style="{StaticResource T.Muted}" Visibility="{Binding TopProducts.Count, Converter={StaticResource NoValueToVis}}"/>
                        <ItemsControl ItemsSource="{Binding TopProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Row.Divider}" BorderThickness="0,0,0,1" Padding="0,7">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource T.Mono}" Foreground="{DynamicResource Text.Muted}">
                                                <Run Text="{Binding Units, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Revenue, Mode=OneWay, Converter={StaticResource Money}, ConverterParameter=number}"/><Run Text=" · "/><Run Text="{Binding Profit, Mode=OneWay, Converter={StaticResource Money}, ConverterParameter=number}" Foreground="{DynamicResource Accent}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Session modes -->
                <Border Grid.Row="8" Grid.Column="2" Style="{StaticResource Card}" Padding="22,20">
                    <StackPanel>
                        <TextBlock Text="Session modes" Style="{StaticResource T.Section}" Margin="0,0,0,12"/>
                        <Border Height="14" CornerRadius="7" ClipToBounds="True" Background="{DynamicResource Border}" Visibility="{Binding ModesLegend, Converter={StaticResource NotEqualsToVis}, ConverterParameter=No sessions}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding OpenShare, Converter={StaticResource FractionStar}}"/>
                                    <ColumnDefinition Width="{Binding FixedShare, Converter={StaticResource FractionStar}}"/>
                                    <ColumnDefinition Width="{Binding BudgetShare, Converter={StaticResource FractionStar}}"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource Accent}"/>
                                <Border Grid.Column="1" Background="{DynamicResource Info}"/>
                                <Border Grid.Column="2" Background="{DynamicResource Warning}"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding ModesLegend}" Style="{StaticResource T.Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Insights}" Style="{StaticResource T.Muted}" Margin="0,12,0,0" TextWrapping="Wrap" TextTrimming="None" LineHeight="19"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="6" Style="{StaticResource Card}" Padding="22,20">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding BusiestText}" Style="{StaticResource T.Muted}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                            <TextBlock Text="Busy hours" Style="{StaticResource T.Section}"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding HourBars}" ItemTemplate="{StaticResource ColumnBar}" Height="170" Margin="0,16,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="6" Grid.Column="2" Style="{StaticResource Card}" Padding="22,20">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding BestDayText}" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
                            <TextBlock Text="Revenue by weekday" Style="{StaticResource T.Section}"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding WeekdayBars}" ItemTemplate="{StaticResource ColumnBar}" Height="170" Margin="0,16,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="10" Style="{StaticResource Card}" Padding="22,20">
                    <StackPanel>
                        <TextBlock Text="Payment methods" Style="{StaticResource T.Section}"/>
                        <TextBlock Text="No payments in this period." Style="{StaticResource T.Muted}" Margin="0,14,0,0" Visibility="{Binding Methods.Count, Converter={StaticResource NoValueToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Methods}" ItemTemplate="{StaticResource BarRow}" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="10" Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="22,20">
                        <StackPanel>
                            <TextBlock Text="Revenue by room" Style="{StaticResource T.Section}"/>
                        <TextBlock Text="No sessions in this period." Style="{StaticResource T.Muted}" Margin="0,14,0,0" Visibility="{Binding Rooms.Count, Converter={StaticResource NoValueToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Rooms}" ItemTemplate="{StaticResource BarRow}" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="22,20">
                        <StackPanel>
                            <TextBlock Text="Revenue by console type" Style="{StaticResource T.Section}"/>
                        <TextBlock Text="No sessions in this period." Style="{StaticResource T.Muted}" Margin="0,14,0,0" Visibility="{Binding Types.Count, Converter={StaticResource NoValueToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Types}" ItemTemplate="{StaticResource BarRow}" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="12" Style="{StaticResource Card}" Padding="22,20">
                    <StackPanel>
                        <TextBlock Text="Station usage" Style="{StaticResource T.Section}"/>
                        <Grid Margin="0,14,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="STATION" Style="{StaticResource T.ColumnHeader}"/>
                            <TextBlock Grid.Column="1" Text="SESSIONS" Style="{StaticResource T.ColumnHeader}"/>
                            <TextBlock Grid.Column="2" Text="PLAY TIME" Style="{StaticResource T.ColumnHeader}"/>
                            <TextBlock Grid.Column="3" Text="REVENUE" Style="{StaticResource T.ColumnHeader}"/>
                            <TextBlock Grid.Column="4" Text="OCCUPANCY" Style="{StaticResource T.ColumnHeader}"/>
                        </Grid>
                        <TextBlock Text="No gaming stations yet" Style="{StaticResource T.Muted}" Visibility="{Binding StationUsage.Count, Converter={StaticResource NoValueToVis}}"/>
                        <ItemsControl ItemsSource="{Binding StationUsage}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Row.Divider}" BorderThickness="0,1,0,0" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="1.4*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}" FontWeight="Medium"/>
                                                <TextBlock Text="{Binding Where}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Sessions}" Style="{StaticResource T.Mono}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding PlayTime}" Style="{StaticResource T.Mono}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Revenue}" Style="{StaticResource T.MonoStrong}" VerticalAlignment="Center"/>
                                            <DockPanel Grid.Column="4" VerticalAlignment="Center">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Occupancy}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{DynamicResource Text.Muted}" Width="40" TextAlignment="Right"/>
                                                <Border Height="6" CornerRadius="3" Background="{DynamicResource Border}" ClipToBounds="True" VerticalAlignment="Center">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionStar}}"/>
                                                            <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionStar}, ConverterParameter=rest}"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="{DynamicResource Info}" CornerRadius="3"/>
                                                    </Grid>
                                                </Border>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="12" Grid.Column="2" Style="{StaticResource Card}" Padding="22,20">
                    <StackPanel>
                        <TextBlock Text="Product categories" Style="{StaticResource T.Section}"/>
                        <TextBlock Text="No product sales in this period." Style="{StaticResource T.Muted}" Margin="0,14,0,0" Visibility="{Binding Categories.Count, Converter={StaticResource NoValueToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource BarRow}" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="16" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="22,20">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="spent in this period" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
                            <TextBlock Text="Top customers" Style="{StaticResource T.Section}"/>
                        </DockPanel>
                        <TextBlock Text="No customers yet." Style="{StaticResource T.Muted}" Margin="0,12,0,0" Visibility="{Binding TopCustomers.Count, Converter={StaticResource NoValueToVis}}"/>
                        <ItemsControl ItemsSource="{Binding TopCustomers}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Row.Divider}" BorderThickness="0,0,0,1" Padding="0,8" Margin="0,0,24,0">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Spent}" Style="{StaticResource T.MonoStrong}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding Owes}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Danger}" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}" FontWeight="Medium"/>
                                                <TextBlock Text="{Binding Visits}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Accounts: what each user took in and gave away -->
                <Border Grid.Row="14" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="22,20">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                <TextBlock Text="Cash" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" Margin="6,0,14,0"/>
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource Info}" VerticalAlignment="Center"/>
                                <TextBlock Text="Card" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" Margin="6,0,14,0"/>
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource Neutral}" VerticalAlignment="Center"/>
                                <TextBlock Text="Other" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Accounts" Style="{StaticResource T.Section}"/>
                                <TextBlock Text="{Binding AccountsSummary}" Style="{StaticResource T.Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="No payments in this period." Style="{StaticResource T.Muted}" Margin="0,14,0,0" Visibility="{Binding Operators.Count, Converter={StaticResource NoValueToVis}}"/>

                        <!-- Ranking: who took in the most -->
                        <ItemsControl ItemsSource="{Binding Operators}" Margin="0,16,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1" Height="14" CornerRadius="4" Background="{DynamicResource Border}" ClipToBounds="True" VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Rank, Converter={StaticResource FractionStar}}"/>
                                                    <ColumnDefinition Width="{Binding Rank, Converter={StaticResource FractionStar}, ConverterParameter=rest}"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- The account's bar, split by cash / card / other -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding CashFrac, Converter={StaticResource FractionStar}}"/>
                                                        <ColumnDefinition Width="{Binding CardFrac, Converter={StaticResource FractionStar}}"/>
                                                        <ColumnDefinition Width="{Binding OtherFrac, Converter={StaticResource FractionStar}}"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{DynamicResource Accent}"/>
                                                    <Border Grid.Column="1" Background="{DynamicResource Info}"/>
                                                    <Border Grid.Column="2" Background="{DynamicResource Neutral}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Column="2" Style="{StaticResource T.MonoStrong}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Run Text="{Binding Collected, Mode=OneWay}"/> <Run Text="{x:Static cm:Money.CurrencySymbol}" FontFamily="{DynamicResource Font.UI}" FontSize="11" Foreground="{DynamicResource Text.Muted}"/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- One card per account -->
                        <ItemsControl ItemsSource="{Binding Operators}" Margin="-8,8,-8,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" VerticalAlignment="Top"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="8" Padding="18,16" CornerRadius="12" Background="{DynamicResource Bg.App}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource Accent.Soft}" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Initials}" Style="{StaticResource T.Base}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Role}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <TextBlock Text="Money taken in" Style="{StaticResource T.Muted}" Margin="0,14,0,0"/>
                                            <TextBlock Style="{StaticResource T.StatValue}" FontSize="26"><Run Text="{Binding Collected, Mode=OneWay}"/> <Run Text="{x:Static cm:Money.CurrencySymbol}" FontFamily="{DynamicResource Font.UI}" FontSize="12" Foreground="{DynamicResource Text.Muted}"/></TextBlock>
                                            <TextBlock Text="{Binding ShareText}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Accent}"/>

                                            <!-- Cash / card / other split -->
                                            <Border Height="8" CornerRadius="4" Background="{DynamicResource Border}" ClipToBounds="True" Margin="0,12,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding CashFrac, Converter={StaticResource FractionStar}}"/>
                                                        <ColumnDefinition Width="{Binding CardFrac, Converter={StaticResource FractionStar}}"/>
                                                        <ColumnDefinition Width="{Binding OtherFrac, Converter={StaticResource FractionStar}}"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{DynamicResource Accent}"/>
                                                    <Border Grid.Column="1" Background="{DynamicResource Info}"/>
                                                    <Border Grid.Column="2" Background="{DynamicResource Neutral}"/>
                                                </Grid>
                                            </Border>
                                            <UniformGrid Columns="3">
                                                <StackPanel><TextBlock Text="Cash" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}"/><TextBlock Text="{Binding CashText}" Style="{StaticResource T.Mono}" FontSize="12"/></StackPanel>
                                                <StackPanel><TextBlock Text="Card" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}"/><TextBlock Text="{Binding CardText}" Style="{StaticResource T.Mono}" FontSize="12"/></StackPanel>
                                                <StackPanel><TextBlock Text="Other" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}"/><TextBlock Text="{Binding OtherText}" Style="{StaticResource T.Mono}" FontSize="12"/></StackPanel>
                                            </UniformGrid>

                                            <!-- Money taken per day -->
                                            <ItemsControl ItemsSource="{Binding Bars}" Height="70" Margin="0,14,0,0">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="1,0" ToolTip="{Binding Value}" Background="Transparent">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="{Binding Height, Converter={StaticResource FractionStar}, ConverterParameter=rest}"/>
                                                                <RowDefinition Height="{Binding Height, Converter={StaticResource FractionStar}}"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Border Grid.Row="1" Background="{DynamicResource Accent}" CornerRadius="2,2,0,0" MinHeight="1" Opacity="0.85"/>
                                                            <TextBlock Grid.Row="2" Text="{Binding Label}" Style="{StaticResource T.Faint}" FontSize="9" Foreground="{DynamicResource Text.Faint}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Work and money given away -->
                                            <Border BorderBrush="{DynamicResource Row.Divider}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding ReceiptsCount}" Style="{StaticResource T.Mono}" FontSize="12"/><TextBlock Text="Receipts" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}"/></DockPanel>
                                                    <DockPanel Margin="0,0,0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding SessionsText}" Style="{StaticResource T.Mono}" FontSize="12"/><TextBlock Text="Sessions started" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}"/></DockPanel>
                                                    <DockPanel Margin="0,0,0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding SalesText}" Style="{StaticResource T.Mono}" FontSize="12"/><TextBlock Text="Bills closed" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}"/></DockPanel>
                                                    <DockPanel Margin="0,0,0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding RepaidText}" Style="{StaticResource T.Mono}" FontSize="12" Foreground="{DynamicResource Accent}"/><TextBlock Text="Credit paid back to them" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}"/></DockPanel>
                                                    <DockPanel Margin="0,0,0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding DiscountText}" Style="{StaticResource T.Mono}" FontSize="12" Foreground="{DynamicResource Warning}"/><TextBlock Text="Discounts given" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}"/></DockPanel>
                                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding CreditGivenText}" Style="{StaticResource T.Mono}" FontSize="12" Foreground="{DynamicResource Danger}"/><TextBlock Text="Left on credit" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}"/></DockPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
