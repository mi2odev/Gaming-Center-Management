<UserControl x:Class="GamingCenter.App.Views.Pages.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <DockPanel Margin="32,24,32,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Grid Width="280" Margin="0,0,12,0">
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Name or phone…" Padding="34,0,12,0"/>
                        <c:Icon Data="{StaticResource I.Search}" Width="15" Height="15" Foreground="{DynamicResource Text.Faint}" HorizontalAlignment="Left" Margin="12,0,0,0"/>
                    </Grid>
                    <Button Content="Export CSV" Style="{StaticResource Btn.Secondary}" c:Ui.Icon="{StaticResource I.Download}" Margin="0,0,12,0" Command="{Binding ExportCommand}"/>
                    <Button Content="Add customer" Style="{StaticResource Btn.Primary}" c:Ui.Icon="{StaticResource I.Plus}" Command="{Binding AddCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Customers are optional — sessions can always start as walk-in." Style="{StaticResource T.Faint}" Margin="0,0,0,14"/>

            <Grid DockPanel.Dock="Top" Margin="14,0,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="150"/><ColumnDefinition Width="80"/><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="NAME" Style="{StaticResource T.ColumnHeader}"/>
                <TextBlock Grid.Column="2" Text="PHONE" Style="{StaticResource T.ColumnHeader}"/>
                <TextBlock Grid.Column="3" Text="SESSIONS" Style="{StaticResource T.ColumnHeader}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="4" Text="TOTAL SPENT" Style="{StaticResource T.ColumnHeader}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="5" Text="LAST VISIT" Style="{StaticResource T.ColumnHeader}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="6" Text="OWES" Style="{StaticResource T.ColumnHeader}" HorizontalAlignment="Right"/>
            </Grid>
            <Grid>
                <TextBlock Text="No customers yet." Style="{StaticResource T.Muted}" HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="{Binding Rows.Count, Converter={StaticResource NoValueToVis}}"/>
                <ListBox Style="{StaticResource RowList}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="50">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="150"/><ColumnDefinition Width="80"/><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Border}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Initials}" Style="{StaticResource T.Base}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource T.Base}" FontWeight="Medium" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Phone}" Style="{StaticResource T.Mono}" FontSize="12" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Sessions}" Style="{StaticResource T.Mono}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding Spent}" Style="{StaticResource T.MonoStrong}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{Binding LastVisit}" Style="{StaticResource T.Mono}" FontSize="12" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="{Binding Owes}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource T.MonoStrong}">
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding HasDebt}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>

        <Border Grid.Column="1" Width="400" Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
            <DockPanel Margin="28,24">
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="{Binding EditError}" Style="{StaticResource T.Error}" Margin="0,0,0,10"/>
                    <UniformGrid Columns="2" Margin="-5,0">
                        <Button Content="Cancel" Style="{StaticResource Btn.Secondary}" Height="42" Margin="5,0" Command="{Binding CancelEditCommand}"/>
                        <Button Content="Save" Style="{StaticResource Btn.Primary}" Height="42" Margin="5,0" Command="{Binding SaveCommand}"/>
                    </UniformGrid>
                    <Border Style="{StaticResource Notice.Info}" Margin="0,14,0,0" Visibility="{Binding EditId, Converter={StaticResource HasValueToVis}}">
                        <StackPanel>
                            <TextBlock Text="Charge to credit" Style="{StaticResource T.Base}" FontWeight="SemiBold"/>
                            <TextBlock Text="The customer takes something now and pays later, even without playing." Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,10"/>
                            <UniformGrid Columns="2" Margin="-4,0">
                                <Button Content="Products" Style="{StaticResource Btn.Secondary}" c:Ui.Icon="{StaticResource I.Cart}" Height="38" Margin="4,0" Command="{Binding ChargeProductsCommand}"
                                        ToolTip="Pick drinks or food from the product list; stock goes down"/>
                                <Button Content="Amount" Style="{StaticResource Btn.Secondary}" c:Ui.Icon="{StaticResource I.Plus}" Height="38" Margin="4,0" Command="{Binding ChargeAmountCommand}"
                                        ToolTip="Type an amount and what it is for"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Button Content="Credit history / record payment →" Style="{StaticResource Btn.LinkAccent}" HorizontalAlignment="Left" Margin="0,14,0,0" Command="{Binding OpenCreditCommand}"
                            Visibility="{Binding EditId, Converter={StaticResource HasValueToVis}}"/>
                    <Button Content="Delete customer" Style="{StaticResource Btn.LinkDanger}" HorizontalAlignment="Left" Margin="0,14,0,0" Command="{Binding DeleteCommand}" Visibility="{Binding ShowDelete, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource T.H15}"/>
                    <TextBlock Text="{Binding EditStats}" Style="{StaticResource T.Muted}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding EditStats, Converter={StaticResource HasValueToVis}}"/>
                    <TextBlock Text="Name" Style="{StaticResource T.Label}" Margin="0,18,0,6"/>
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Phone" Style="{StaticResource T.Label}" Margin="0,12,0,6"/>
                    <TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Mono}"/>
                    <TextBlock Text="Notes" Style="{StaticResource T.Label}" Margin="0,12,0,6"/>
                    <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Multiline}" Height="110"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
