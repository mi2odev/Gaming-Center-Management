<UserControl x:Class="GamingCenter.App.Views.Pages.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls"
             xmlns:parts="clr-namespace:GamingCenter.App.Views.Parts"
             x:Name="Root">
    <UserControl.Resources>
        <!-- Round tile with the category icon -->
        <DataTemplate x:Key="CategoryTile">
            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Danger.Soft}">
                <c:Icon Data="{Binding Converter={StaticResource ExpenseIcon}}" Width="17" Height="17" Foreground="{DynamicResource Danger}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <!-- Small square icon in the top-right corner of a summary card -->
        <Style x:Key="KpiIcon" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </UserControl.Resources>

    <!-- What the owner spends on the center (new TV, rent, bills…) and the profit left after it -->
    <DockPanel Margin="32,24,32,0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Grid Width="220" Margin="0,0,12,0">
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Search expenses…" Padding="34,0,12,0"/>
                    <c:Icon Data="{StaticResource I.Search}" Width="15" Height="15" Foreground="{DynamicResource Text.Faint}" HorizontalAlignment="Left" Margin="12,0,0,0"/>
                </Grid>
                <Button Content="Export CSV" Style="{StaticResource Btn.Secondary}" c:Ui.Icon="{StaticResource I.Download}" Margin="0,0,12,0" Command="{Binding ExportCommand}"/>
                <Button Content="Add expense" Style="{StaticResource Btn.Primary}" c:Ui.Icon="{StaticResource I.Plus}" Command="{Binding AddCommand}"
                        ToolTip="Something you paid for the center: a new TV, a controller, rent, electricity…"/>
            </StackPanel>
            <parts:PeriodPicker/>
        </DockPanel>

        <!-- Summary -->
        <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="3" Margin="-8,0,-8,22">
            <Border Style="{StaticResource Card}" Margin="8,0" Padding="20,18">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource KpiIcon}" Background="{DynamicResource Danger.Soft}">
                        <c:Icon Data="{StaticResource I.Banknote}" Width="17" Height="17" Foreground="{DynamicResource Danger}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Spent" Style="{StaticResource T.Muted}"/>
                        <TextBlock Text="{Binding TotalText}" Style="{StaticResource T.StatValue}" FontSize="26" Foreground="{DynamicResource Danger}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0" Padding="20,18">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource KpiIcon}" Background="{DynamicResource Pill.Bg}">
                        <c:Icon Data="{StaticResource I.Receipt}" Width="17" Height="17" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Money received" Style="{StaticResource T.Muted}" ToolTip="Payments at the till plus credit paid back, in the same period"/>
                        <TextBlock Text="{Binding IncomeText}" Style="{StaticResource T.StatValue}" FontSize="26" Margin="0,6,0,0"/>
                        <TextBlock Text="sessions and sales" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0" Padding="20,18">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource KpiIcon}" Background="{DynamicResource Accent.Soft}">
                        <c:Icon Data="{StaticResource I.Chart}" Width="17" Height="17" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Net profit" Style="{StaticResource T.Muted}" ToolTip="Money received minus expenses"/>
                        <TextBlock Text="{Binding NetText}" FontSize="26" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource T.StatValue}">
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding NetNegative}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- How much of what came in went out again -->
                        <Border Height="5" CornerRadius="3" Background="{DynamicResource Accent.Soft}" Margin="0,10,0,0" ClipToBounds="True"
                                ToolTip="Red part: money spent, compared with money received">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding SpentShare, Converter={StaticResource FractionStar}}"/>
                                    <ColumnDefinition Width="{Binding SpentShare, Converter={StaticResource FractionStar}, ConverterParameter=rest}"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource Danger}" CornerRadius="3"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding SpentShareText}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" Margin="0,5,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>

            <!-- Expense list -->
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="14,0,14,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="130"/><ColumnDefinition Width="100"/><ColumnDefinition Width="130"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="WHAT" Style="{StaticResource T.ColumnHeader}"/>
                    <TextBlock Grid.Column="2" Text="CATEGORY" Style="{StaticResource T.ColumnHeader}"/>
                    <TextBlock Grid.Column="3" Text="DATE" Style="{StaticResource T.ColumnHeader}"/>
                    <TextBlock Grid.Column="4" Text="AMOUNT" Style="{StaticResource T.ColumnHeader}" HorizontalAlignment="Right"/>
                </Grid>
                <Grid>
                    <ListBox x:Name="List" Style="{StaticResource RowList}" ItemsSource="{Binding Rows}" MouseDoubleClick="OnRowDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="60">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="130"/><ColumnDefinition Width="100"/><ColumnDefinition Width="130"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{Binding CategoryValue}" ContentTemplate="{StaticResource CategoryTile}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,8,16,8">
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource T.Base}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Meta}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource Pill}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}" Style="{StaticResource T.Base}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Text.Muted}"/>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding Date}" Style="{StaticResource T.Mono}" FontSize="12" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Amount}" Style="{StaticResource T.MonoStrong}" FontSize="14" Foreground="{DynamicResource Danger}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <!-- Actions appear when the row is hovered or selected, to keep the list calm -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button Style="{StaticResource Btn.Icon}" Width="30" Height="30" MinHeight="0" c:Ui.Icon="{StaticResource I.Edit}" ToolTip="Edit"
                                                Command="{Binding DataContext.EditCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource Btn.Icon}" Width="30" Height="30" MinHeight="0" Margin="4,0,0,0" c:Ui.Icon="{StaticResource I.Trash}" ToolTip="Delete"
                                                Command="{Binding DataContext.DeleteCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty states come after the list, so they sit above it and their buttons can be clicked -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" Visibility="{Binding NoMatches, Converter={StaticResource BoolToVis}}">
                        <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource Pill.Bg}" HorizontalAlignment="Center">
                            <c:Icon Data="{StaticResource I.Search}" Width="28" Height="28" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No expenses match your search." Style="{StaticResource T.Section}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <Button Content="Clear search" Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Center" Margin="0,18,0,0" Command="{Binding ClearSearchCommand}"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource Pill.Bg}" HorizontalAlignment="Center">
                            <c:Icon Data="{StaticResource I.Banknote}" Width="28" Height="28" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No expenses in this period." Style="{StaticResource T.Section}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="When you buy something for the center, like a new TV or a controller, or pay rent or a bill, add it here. Its price is taken off your profit in Reports."
                                   Style="{StaticResource T.Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" Margin="0,6,0,0"/>
                        <Button Content="Add expense" Style="{StaticResource Btn.Primary}" c:Ui.Icon="{StaticResource I.Plus}" HorizontalAlignment="Center" Margin="0,18,0,0"
                                Command="{Binding AddCommand}"/>
                    </StackPanel>
                </Grid>
            </DockPanel>

            <!-- Breakdown by category -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18" VerticalAlignment="Top" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="By category" Style="{StaticResource T.Section}" Margin="0,0,0,16"/>
                    <TextBlock Text="Nothing spent yet." Style="{StaticResource T.Muted}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,16">
                                    <ContentPresenter DockPanel.Dock="Left" Content="{Binding Category}" ContentTemplate="{StaticResource CategoryTile}" VerticalAlignment="Top" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource T.MonoStrong}" FontSize="12"/>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}" FontSize="12" FontWeight="Medium"/>
                                        </DockPanel>
                                        <Border Height="5" CornerRadius="3" Background="{DynamicResource Border}" Margin="0,6,0,0" ClipToBounds="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionStar}}"/>
                                                    <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionStar}, ConverterParameter=rest}"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{DynamicResource Danger}" CornerRadius="3"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
