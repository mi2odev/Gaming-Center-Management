<UserControl x:Class="GamingCenter.App.Views.Pages.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls"
             xmlns:parts="clr-namespace:GamingCenter.App.Views.Parts"
             x:Name="Root">
    <!-- What the owner spends on the center (new TV, rent, bills…) and the profit left after it -->
    <DockPanel Margin="32,24,32,0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Grid Width="220" Margin="0,0,12,0">
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Search expenses…" Padding="34,0,12,0"/>
                    <c:Icon Data="{StaticResource I.Search}" Width="15" Height="15" Foreground="{DynamicResource Text.Faint}" HorizontalAlignment="Left" Margin="12,0,0,0"/>
                </Grid>
                <Button Content="Export CSV" Style="{StaticResource Btn.Secondary}" c:Ui.Icon="{StaticResource I.Download}" Margin="0,0,12,0" Command="{Binding ExportCommand}"/>
                <Button Content="Add expense" Style="{StaticResource Btn.Primary}" c:Ui.Icon="{StaticResource I.Plus}" Command="{Binding AddCommand}"
                        ToolTip="Something you paid for the center: a new TV, a controller, rent, electricity…"/>
            </StackPanel>
            <parts:PeriodPicker/>
        </DockPanel>

        <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="3" Margin="-7,0,-7,20">
            <Border Style="{StaticResource Card}" Margin="7,0">
                <StackPanel>
                    <TextBlock Text="Spent" Style="{StaticResource T.Muted}"/>
                    <TextBlock Text="{Binding TotalText}" Style="{StaticResource T.StatValue}" FontSize="24" Foreground="{DynamicResource Danger}"/>
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="7,0">
                <StackPanel>
                    <TextBlock Text="Money received" Style="{StaticResource T.Muted}" ToolTip="Payments at the till plus credit paid back, in the same period"/>
                    <TextBlock Text="{Binding IncomeText}" Style="{StaticResource T.StatValue}" FontSize="24"/>
                    <TextBlock Text="sessions and sales" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="7,0">
                <StackPanel>
                    <TextBlock Text="Net profit" Style="{StaticResource T.Muted}" ToolTip="Money received minus expenses"/>
                    <TextBlock Text="{Binding NetText}" FontSize="24">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource T.StatValue}">
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Style.Triggers><DataTrigger Binding="{Binding NetNegative}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="money received − spent" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>

            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="14,0,14,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                    <TextBlock Text="DATE" Style="{StaticResource T.ColumnHeader}"/>
                    <TextBlock Grid.Column="1" Text="WHAT" Style="{StaticResource T.ColumnHeader}"/>
                    <TextBlock Grid.Column="2" Text="CATEGORY" Style="{StaticResource T.ColumnHeader}"/>
                    <TextBlock Grid.Column="3" Text="ADDED BY" Style="{StaticResource T.ColumnHeader}"/>
                    <TextBlock Grid.Column="4" Text="AMOUNT" Style="{StaticResource T.ColumnHeader}" HorizontalAlignment="Right"/>
                </Grid>
                <Grid>
                    <StackPanel HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="No expenses in this period." Style="{StaticResource T.Section}" HorizontalAlignment="Center"/>
                        <TextBlock Text="When you buy something for the center, like a new TV or a controller, or pay rent or a bill, add it here. Its price is taken off your profit in Reports."
                                   Style="{StaticResource T.Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440" Margin="0,6,0,0"/>
                    </StackPanel>
                    <ListBox Style="{StaticResource RowList}" ItemsSource="{Binding Rows}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="52">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Date}" Style="{StaticResource T.Mono}" FontSize="12" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,6,12,6">
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource T.Base}" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource T.Faint}" Visibility="{Binding Note, Converter={StaticResource HasValueToVis}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Category}" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding User}" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Amount}" Style="{StaticResource T.MonoStrong}" Foreground="{DynamicResource Danger}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="Edit" Style="{StaticResource Btn.Link}" Margin="0,0,14,0" Command="{Binding DataContext.EditCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                        <Button Content="Delete" Style="{StaticResource Btn.LinkDanger}" Command="{Binding DataContext.DeleteCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>

            <!-- Breakdown by category -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18" VerticalAlignment="Top" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="By category" Style="{StaticResource T.Section}" Margin="0,0,0,14"/>
                    <TextBlock Text="Nothing spent yet." Style="{StaticResource T.Muted}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource T.MonoStrong}" FontSize="12"/>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}" FontSize="12"/>
                                    </DockPanel>
                                    <Border Height="6" CornerRadius="3" Background="{DynamicResource Border}" Margin="0,5,0,0" ClipToBounds="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionStar}}"/>
                                                <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionStar}, ConverterParameter=rest}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{DynamicResource Danger}" CornerRadius="3"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Sub}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
