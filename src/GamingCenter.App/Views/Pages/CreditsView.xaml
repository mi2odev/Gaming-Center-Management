<UserControl x:Class="GamingCenter.App.Views.Pages.CreditsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls">
    <!-- Customers who owe money ("pay later"), their history and repayments -->
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <DockPanel Margin="32,24,32,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Grid Width="240" Margin="0,0,12,0">
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Name or phone…" Padding="34,0,12,0"/>
                        <c:Icon Data="{StaticResource I.Search}" Width="15" Height="15" Foreground="{DynamicResource Text.Faint}" HorizontalAlignment="Left" Margin="12,0,0,0"/>
                    </Grid>
                    <Button Content="Export CSV" Style="{StaticResource Btn.Secondary}" c:Ui.Icon="{StaticResource I.Download}" Margin="0,0,12,0" Command="{Binding ExportCommand}"/>
                    <Button Content="Add amount" Style="{StaticResource Btn.Secondary}" c:Ui.Icon="{StaticResource I.Plus}" Margin="0,0,12,0" Command="{Binding AddDebtCommand}"
                            ToolTip="Charge an amount to a customer (food not in the list, old debt…)"/>
                    <Button Content="Charge products" Style="{StaticResource Btn.Primary}" c:Ui.Icon="{StaticResource I.Cart}" Command="{Binding ChargeProductsCommand}"
                            ToolTip="Sell products to the selected customer on credit, without a session"/>
                </StackPanel>
                <CheckBox Content="Show settled customers too" IsChecked="{Binding ShowSettled}" VerticalAlignment="Center"/>
            </DockPanel>

            <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="3" Margin="-7,0,-7,20">
                <Border Style="{StaticResource Card.Warning}" Margin="7,0">
                    <StackPanel><TextBlock Text="Total owed to you" Style="{StaticResource T.Muted}" Foreground="{DynamicResource Warning}"/><TextBlock Text="{Binding TotalText}" Style="{StaticResource T.StatValue}" FontSize="24" Foreground="{DynamicResource Warning}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7,0">
                    <StackPanel><TextBlock Text="Customers" Style="{StaticResource T.Muted}"/><TextBlock Text="{Binding CountText}" Style="{StaticResource T.Base}" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7,0">
                    <StackPanel><TextBlock Text="Oldest unpaid" Style="{StaticResource T.Muted}"/><TextBlock Text="{Binding OldestText}" Style="{StaticResource T.Base}" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel>
                </Border>
            </UniformGrid>

            <Grid DockPanel.Dock="Top" Margin="14,0,14,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="140"/><ColumnDefinition Width="80"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="CUSTOMER" Style="{StaticResource T.ColumnHeader}"/>
                <TextBlock Grid.Column="2" Text="PHONE" Style="{StaticResource T.ColumnHeader}"/>
                <TextBlock Grid.Column="3" Text="BILLS" Style="{StaticResource T.ColumnHeader}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="4" Text="LAST CREDIT" Style="{StaticResource T.ColumnHeader}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="5" Text="WAITING" Style="{StaticResource T.ColumnHeader}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="6" Text="OWES" Style="{StaticResource T.ColumnHeader}" HorizontalAlignment="Right"/>
            </Grid>
            <Grid>
                <StackPanel HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Nobody owes you money." Style="{StaticResource T.Section}" HorizontalAlignment="Center"/>
                    <TextBlock Text="When a customer can't pay the whole bill, tick &quot;Pay the rest later&quot; on the bill. Their name and the unpaid amount appear here." Style="{StaticResource T.Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440" Margin="0,6,0,0"/>
                </StackPanel>
                <ListBox Style="{StaticResource RowList}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="50">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="140"/><ColumnDefinition Width="80"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Border}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Initials}" Style="{StaticResource T.Base}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource T.Base}" FontWeight="Medium" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Phone}" Style="{StaticResource T.Mono}" FontSize="12" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Bills}" Style="{StaticResource T.Mono}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding LastCredit}" Style="{StaticResource T.Mono}" FontSize="12" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{Binding Age}" Style="{StaticResource T.Mono}" FontSize="12" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="{Binding Balance}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource T.MonoStrong}">
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding Owes}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>

        <!-- History of the selected customer -->
        <Border Grid.Column="1" Width="420" Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0"
                Visibility="{Binding Selected, Converter={StaticResource HasValueToVis}}">
            <DockPanel Margin="28,24">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource T.Base}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Selected.Phone}" Style="{StaticResource T.Mono}" FontSize="12" Foreground="{DynamicResource Text.Muted}" Margin="0,2,0,0"/>
                    <Border Style="{StaticResource Notice.Warning}" Margin="0,16,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Selected.Balance}" Style="{StaticResource T.MonoStrong}" FontSize="22" Foreground="{DynamicResource Warning}"/>
                            <TextBlock Text="Owes" Style="{StaticResource T.Base}" FontWeight="SemiBold" Foreground="{DynamicResource Warning}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Button Content="Record payment" Style="{StaticResource Btn.Primary}" Height="44" Margin="0,14,0,0" Command="{Binding RecordPaymentCommand}"
                            IsEnabled="{Binding Selected.Owes}"/>
                    <TextBlock Text="History" Style="{StaticResource T.Muted}" FontWeight="SemiBold" Margin="0,22,0,10"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Row.Divider}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Amount}" HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource T.MonoStrong}">
                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsDebt}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource T.Faint}" HorizontalAlignment="Right"><Run Text="balance "/><Run Text="{Binding BalanceAfter, Mode=OneWay}"/></TextBlock>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding What}" Style="{StaticResource T.Base}" FontWeight="Medium"/>
                                            <TextBlock Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}"><Run Text="{Binding Date, Mode=OneWay}"/> <Run Text="{Binding User, Mode=OneWay}"/></TextBlock>
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource T.Faint}" TextWrapping="Wrap" Visibility="{Binding Note, Converter={StaticResource HasValueToVis}}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
