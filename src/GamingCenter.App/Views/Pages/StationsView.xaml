<UserControl x:Class="GamingCenter.App.Views.Pages.StationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls"
             xmlns:parts="clr-namespace:GamingCenter.App.Views.Parts"
             xmlns:cm="clr-namespace:GamingCenter.Application.Common;assembly=GamingCenter.Application"
             x:Name="Root">
    <!-- Design 1h -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <DockPanel Margin="32,24,32,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Grid Width="280" Margin="0,0,12,0">
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Filter by name, type, room…" Padding="34,0,12,0"/>
                        <c:Icon Data="{StaticResource I.Search}" Width="15" Height="15" Foreground="{DynamicResource Text.Faint}" HorizontalAlignment="Left" Margin="12,0,0,0"/>
                    </Grid>
                    <Button Content="Manage types" Style="{StaticResource Btn.Secondary}" Margin="0,0,12,0" Command="{Binding ManageTypesCommand}"/>
                    <Button Content="Add station" Style="{StaticResource Btn.Primary}" c:Ui.Icon="{StaticResource I.Plus}" Command="{Binding AddCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Column headers -->
            <Grid DockPanel.Dock="Top" Margin="14,0,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="IMAGE" Style="{StaticResource T.ColumnHeader}"/>
                <TextBlock Grid.Column="1" Text="NAME" Style="{StaticResource T.ColumnHeader}"/>
                <TextBlock Grid.Column="2" Text="TYPE" Style="{StaticResource T.ColumnHeader}"/>
                <TextBlock Grid.Column="3" Text="MODEL" Style="{StaticResource T.ColumnHeader}"/>
                <TextBlock Grid.Column="4" Text="PRICE / H" Style="{StaticResource T.ColumnHeader}"/>
                <TextBlock Grid.Column="5" Text="STATUS" Style="{StaticResource T.ColumnHeader}"/>
                <TextBlock Grid.Column="6" Text="LOCATION" Style="{StaticResource T.ColumnHeader}"/>
                <TextBlock Grid.Column="7" Text="ACTIONS" Style="{StaticResource T.ColumnHeader}" HorizontalAlignment="Right"/>
            </Grid>

            <Grid>
                <TextBlock Text="No stations match." Style="{StaticResource T.Muted}" HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="{Binding Rows.Count, Converter={StaticResource NoValueToVis}}"/>
                <ListBox Style="{StaticResource RowList}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="50">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="32" CornerRadius="5" ClipToBounds="True" HorizontalAlignment="Left">
                                    <parts:Thumb ImagePath="{Binding Station.ImagePath}" TagText="{Binding Station.Tag}" TagSize="9" CornerRadius="5"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Station.Name}" Style="{StaticResource T.Base}" FontWeight="Medium" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Station.TypeName}" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Station.Model}" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding RateLabel}" Style="{StaticResource T.Mono}" FontWeight="Medium" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Style="{StaticResource Dot}" Fill="{Binding StatusKey, Converter={StaticResource StatusBrush}}"/>
                                    <TextBlock Text="{Binding StatusText}" Margin="6,0,0,0" FontFamily="{DynamicResource Font.UI}" FontSize="12" FontWeight="Medium" Foreground="{Binding StatusKey, Converter={StaticResource StatusBrush}}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="6" Text="{Binding Station.Location}" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="Price" Style="{StaticResource Btn.Link}" Margin="0,0,14,0" ToolTip="Change the hourly price" Command="{Binding DataContext.EditPriceCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                    <Button Content="{Binding ToggleLabel}" Style="{StaticResource Btn.Link}" Margin="0,0,14,0" Command="{Binding DataContext.ToggleActiveCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                    <Button Content="Delete" Style="{StaticResource Btn.Link}" Command="{Binding DataContext.DeleteCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>

        <!-- ===== Edit panel ===== -->
        <Border Grid.Column="1" Width="420" Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Padding="28,16,28,24">
                    <StackPanel>
                        <TextBlock Text="{Binding EditError}" Style="{StaticResource T.Error}" Margin="0,0,0,10"/>
                        <UniformGrid Columns="2" Margin="-5,0">
                            <Button Content="Cancel" Style="{StaticResource Btn.Secondary}" Height="42" Margin="5,0" Command="{Binding CancelEditCommand}"/>
                            <Button Content="Save changes" Style="{StaticResource Btn.Primary}" Height="42" Margin="5,0" Command="{Binding SaveCommand}"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,28,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding EditName}" Style="{StaticResource T.Muted}"/>
                            <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource T.H15}"/>
                        </DockPanel>

                        <Border Height="140" CornerRadius="10" BorderBrush="{DynamicResource Border.Dashed}" BorderThickness="1" ClipToBounds="True"
                                c:Ui.ClickCommand="{Binding ChooseImageCommand}" c:Ui.ImageDropCommand="{Binding ImportImageCommand}" ToolTip="Click or drop a picture here">
                            <Grid>
                                <parts:Thumb ImagePath="{Binding EditImage}" TagText="{Binding EditTag}" TagSize="22" CornerRadius="10"/>
                                <TextBlock Text="Click or drop a picture here (JPG, PNG)" Style="{StaticResource T.Muted}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12"
                                           Visibility="{Binding EditImage, Converter={StaticResource NoValueToVis}}"/>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Upload picture…" Style="{StaticResource Btn.Secondary}" c:Ui.Icon="{StaticResource I.Image}" MinHeight="32" Command="{Binding ChooseImageCommand}"/>
                            <Button Content="Remove picture" Style="{StaticResource Btn.Link}" Margin="14,0,0,0" Command="{Binding RemoveImageCommand}"
                                    Visibility="{Binding EditImage, Converter={StaticResource HasValueToVis}}"/>
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.ColumnSpan="3"><TextBlock Text="Name" Style="{StaticResource T.Label}"/><TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="PS5 #12"/></StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,10,0,0"><TextBlock Text="Type" Style="{StaticResource T.Label}"/><ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding EditType}" DisplayMemberPath="Name"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0"><TextBlock Text="Model" Style="{StaticResource T.Label}"/><TextBox Text="{Binding EditModel, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="PS5"/></StackPanel>
                            <StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock Text="Brand" Style="{StaticResource T.Label}"/><TextBox Text="{Binding EditBrand, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Sony"/></StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,10,0,0"><TextBlock Text="Number" Style="{StaticResource T.Label}"/><TextBox Text="{Binding EditNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Mono}" c:Ui.Placeholder="12"/></StackPanel>
                            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                <TextBlock Text="Hourly price" Style="{StaticResource T.Label}"/>
                                <TextBox x:Name="PriceBox" Text="{Binding EditRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Mono}" c:Ui.Suffix="{x:Static cm:Money.CurrencySymbol}" c:Ui.SelectAllOnFocus="True"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,10,0,0"><TextBlock Text="Controllers included" Style="{StaticResource T.Label}"/><TextBox Text="{Binding EditControllers, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Mono}" c:Ui.Placeholder="2"/></StackPanel>
                            <StackPanel Grid.Row="4" Margin="0,10,0,0"><TextBlock Text="Location" Style="{StaticResource T.Label}"/><ComboBox IsEditable="True" ItemsSource="{Binding Locations}" Text="{Binding EditLocation, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Room A"/></StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,10,0,0"><TextBlock Text="Status" Style="{StaticResource T.Label}"/><ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding EditState}"/></StackPanel>
                            <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,10,0,0"><TextBlock Text="Description" Style="{StaticResource T.Label}"/><TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Multiline}" c:Ui.Placeholder="Premium PS5 station, 4K TV"/></StackPanel>
                            <Border Grid.Row="6" Grid.ColumnSpan="3" Style="{StaticResource Notice.Info}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Price by controllers" Style="{StaticResource T.Base}" FontWeight="SemiBold"/>
                                    <TextBlock Text="The hourly price covers the included controllers. Each extra controller the customer asks for adds this amount per hour." Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Maximum controllers" Style="{StaticResource T.Label}"/><TextBox Text="{Binding EditMaxControllers, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Mono}" c:Ui.Placeholder="4"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Own extra price / h (optional)" Style="{StaticResource T.Label}"/><TextBox Text="{Binding EditExtraRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Mono}" c:Ui.Suffix="{x:Static cm:Money.CurrencySymbol}"/></StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding ExtraRateSource}" Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding ControllerPricingHint}" Style="{StaticResource T.Muted}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" TextTrimming="None" Margin="0,10,0,0"
                                               Visibility="{Binding ControllerPricingHint, Converter={StaticResource HasValueToVis}}"/>
                                </StackPanel>
                            </Border>
                            <CheckBox Grid.Row="7" Grid.ColumnSpan="3" Margin="0,14,0,0" Content="Active — available for new sessions" IsChecked="{Binding EditActive}"/>
                        </Grid>

                        <Border Style="{StaticResource Notice.Warning}" Margin="0,16,0,0" Visibility="{Binding PriceNotice, Converter={StaticResource HasValueToVis}}">
                            <TextBlock Text="{Binding PriceNotice}" Style="{StaticResource T.Base}" FontSize="12" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" TextTrimming="None" LineHeight="18"/>
                        </Border>

                        <StackPanel Margin="0,18,0,8" Visibility="{Binding PriceHistory.Count, Converter={StaticResource HasValueToVis}}">
                            <TextBlock Text="Price history" Style="{StaticResource T.Muted}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding PriceHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource T.Mono}" FontSize="12">
                                                <Run Text="{Binding OldRate, Mode=OneWay, Converter={StaticResource Money}, ConverterParameter=number}" Foreground="{DynamicResource Text.Muted}"/><Run Text=" → "/><Run Text="{Binding NewRate, Mode=OneWay, Converter={StaticResource Money}, ConverterParameter=number}"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource T.Faint}" Foreground="{DynamicResource Text.Muted}"><Run Text="{Binding ChangedAt, Mode=OneWay, StringFormat=dd/MM/yyyy HH:mm}"/> <Run Text="{Binding ChangedBy, Mode=OneWay}"/></TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
