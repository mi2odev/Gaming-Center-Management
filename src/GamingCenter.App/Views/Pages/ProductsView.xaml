<UserControl x:Class="GamingCenter.App.Views.Pages.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GamingCenter.App.Controls"
             xmlns:parts="clr-namespace:GamingCenter.App.Views.Parts"
             x:Name="Root">
    <!-- Design 1i -->
    <DockPanel Margin="32,24,32,0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Grid Width="260" Margin="0,0,12,0">
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Search products…" Padding="34,0,12,0"/>
                    <c:Icon Data="{StaticResource I.Search}" Width="15" Height="15" Foreground="{DynamicResource Text.Faint}" HorizontalAlignment="Left" Margin="12,0,0,0"/>
                </Grid>
                <Button Content="Categories" Style="{StaticResource Btn.Secondary}" Margin="0,0,12,0" Command="{Binding ManageCategoriesCommand}"/>
                <Button Content="Receive stock" Style="{StaticResource Btn.Secondary}" Margin="0,0,12,0" Command="{Binding AddStockCommand}" CommandParameter="{x:Null}"/>
                <Button Content="Add product" Style="{StaticResource Btn.Primary}" c:Ui.Icon="{StaticResource I.Plus}" Command="{Binding AddCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
        </DockPanel>

        <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="4" Margin="-7,0,-7,20">
            <Border Style="{StaticResource Card}" Margin="7,0">
                <StackPanel><TextBlock Text="Product revenue today" Style="{StaticResource T.Muted}"/><TextBlock Text="{Binding RevenueToday}" Style="{StaticResource T.StatValue}" FontSize="24"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="7,0">
                <StackPanel><TextBlock Text="Estimated profit today" Style="{StaticResource T.Muted}"/><TextBlock Text="{Binding ProfitToday}" Style="{StaticResource T.StatValue}" FontSize="24" Foreground="{DynamicResource Accent}"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="7,0">
                <StackPanel><TextBlock Text="Stock value (purchase)" Style="{StaticResource T.Muted}"/><TextBlock Text="{Binding StockValue}" Style="{StaticResource T.StatValue}" FontSize="24"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card.Warning}" Margin="7,0">
                <StackPanel><TextBlock Text="Below minimum" Style="{StaticResource T.Muted}" Foreground="{DynamicResource Warning}"/><TextBlock Text="{Binding BelowMinimum}" Style="{StaticResource T.StatValue}" FontSize="24" Foreground="{DynamicResource Warning}"/></StackPanel>
            </Border>
        </UniformGrid>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <ToggleButton DockPanel.Dock="Right" Content="Low stock only" Style="{StaticResource ChipToggle}" IsChecked="{Binding LowStockOnly}"/>
            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"/>
        </DockPanel>

        <Grid DockPanel.Dock="Top" Margin="14,0,14,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/><ColumnDefinition Width="90"/><ColumnDefinition Width="240"/><ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="PRODUCT" Style="{StaticResource T.ColumnHeader}"/>
            <TextBlock Grid.Column="2" Text="CATEGORY" Style="{StaticResource T.ColumnHeader}"/>
            <TextBlock Grid.Column="3" Text="PURCHASE" Style="{StaticResource T.ColumnHeader}"/>
            <TextBlock Grid.Column="4" Text="SELLING" Style="{StaticResource T.ColumnHeader}"/>
            <TextBlock Grid.Column="5" Text="MARGIN" Style="{StaticResource T.ColumnHeader}"/>
            <TextBlock Grid.Column="6" Text="STOCK / MINIMUM" Style="{StaticResource T.ColumnHeader}"/>
            <TextBlock Grid.Column="7" Text="ACTIONS" Style="{StaticResource T.ColumnHeader}" HorizontalAlignment="Right"/>
        </Grid>

        <Grid>
            <TextBlock Text="No products match." Style="{StaticResource T.Muted}" HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="{Binding Rows.Count, Converter={StaticResource NoValueToVis}}"/>
            <ListBox Style="{StaticResource RowList}" ItemsSource="{Binding Rows}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="RowGrid" Height="52">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/><ColumnDefinition Width="90"/><ColumnDefinition Width="240"/><ColumnDefinition Width="230"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="34" CornerRadius="5" ClipToBounds="True" HorizontalAlignment="Left">
                                <parts:Thumb ImagePath="{Binding Product.ImagePath}" TagText="{Binding CategoryTag}" TagSize="8" CornerRadius="5"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource T.Base}" FontWeight="Medium" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Category}" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding BuyText}" Style="{StaticResource T.Mono}" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{Binding SellText}" Style="{StaticResource T.Mono}" FontWeight="Medium" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="{Binding MarginText}" Style="{StaticResource T.Mono}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                            <DockPanel Grid.Column="6" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding StockText}" Style="{StaticResource T.Mono}" FontSize="12" FontWeight="Medium" Width="70" TextAlignment="Right"
                                           Foreground="{Binding StockKey, Converter={StaticResource StatusBrush}}"/>
                                <ProgressBar Height="5" Value="{Binding StockFraction, Mode=OneWay}" Margin="0,0,10,0" Foreground="{Binding StockKey, Converter={StaticResource StatusBrush}}"/>
                            </DockPanel>
                            <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Edit" Style="{StaticResource Btn.Link}" Margin="0,0,14,0" Command="{Binding DataContext.EditCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                <Button Content="+ Stock" Style="{StaticResource Btn.Link}" Margin="0,0,14,0" Command="{Binding DataContext.AddStockCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                <Button Content="{Binding ToggleLabel}" Style="{StaticResource Btn.Link}" Margin="0,0,14,0" Command="{Binding DataContext.ToggleActiveCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                <Button Content="Delete" Style="{StaticResource Btn.Link}" Command="{Binding DataContext.DeleteCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsInactive}" Value="True">
                                <Setter TargetName="RowGrid" Property="Opacity" Value="0.5"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
